              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const t = clamp(factor, 0, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (t <= 0.001) return \'#6F6F6F\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (t >= 0.999) return \'#F4F4F4\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const r = Math.round(INITIAL_WORD_RGB.r + (COMPLETED_WORD_RGB.r - INITIAL_WORD_RGB.r) * t);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const g = Math.round(INITIAL_WORD_RGB.g + (COMPLETED_WORD_RGB.g - INITIAL_WORD_RGB.g) * t);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const b = Math.round(INITIAL_WORD_RGB.b + (COMPLETED_WORD_RGB.b - INITIAL_WORD_RGB.b) * t);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return `rgb(${r}, ${g}, ${b})`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
