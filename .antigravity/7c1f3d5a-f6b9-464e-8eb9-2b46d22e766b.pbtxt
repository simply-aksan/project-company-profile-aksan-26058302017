  code_action {
    action_spec {
      create_file {
        instruction: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>REKAVANTA \342\200\224 Technology &amp; Product Studio</title>\n    <meta\n      name=\"description\"\n      content=\"Build Solutions. Create Possibilities. Rekavanta is a hybrid technology and product studio combining custom software development services with independent digital products.\"\n    />\n    <meta property=\"og:title\" content=\"REKAVANTA \342\200\224 Technology &amp; Product Studio\" />\n    <meta\n      property=\"og:description\"\n      content=\"Build Solutions. Create Possibilities. Rekavanta is a hybrid technology and product studio combining custom software development services with independent digital products.\"\n    />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n\n    <!-- Google Fonts: Archivo (Display/Editorial) & Inter Tight (Body/UI) -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,400..900;1,62..125,400..900&family=Inter+Tight:ital,wght@0,300..700;1,300..700&display=swap\"\n      rel=\"stylesheet\"\n    />\n\n    <style>\n      /* ==========================================================================\n         01. DESIGN TOKENS & SCALE SYSTEM\n         ========================================================================== */\n      :root {\n        /* 1440px proportional unit scale: u = min(100vw / 1440, 1.333px) */\n        --u: min(calc(100vw / 1440), 1.333px);\n\n        /* Hero Light Monochromatic Palette */\n        --hero-bg: #dadada;\n        --hero-surface: #cdcdcd;\n        --hero-surface-hover: #c2c2c2;\n        --hero-text: #111111;\n        --hero-text-secondary: #3a3a3a;\n        --hero-text-muted: #595959;\n        --hero-border: rgba(17, 17, 17, 0.14);\n        --hero-border-strong: rgba(17, 17, 17, 0.28);\n\n        /* Lower Dark Monochromatic Palette */\n        --dark-bg: #000000;\n        --dark-surface: #0a0a0a;\n        --dark-surface-elevated: #111111;\n        --dark-text: #f4f4f4;\n        --dark-text-secondary: #a0a0a0;\n        --dark-text-muted: #6f6f6f;\n        --dark-border: rgba(255, 255, 255, 0.14);\n        --dark-border-strong: rgba(255, 255, 255, 0.28);\n\n        /* Restrained Cool Electric Blue Brand Accent */\n        --accent: #7dafe0;\n        --accent-dim: rgba(125, 175, 224, 0.16);\n        --accent-deep: #255785;\n\n        /* Typography */\n        --font-display: \'Archivo\', -apple-system, BlinkMacSystemFont, sans-serif;\n        --font-sans: \'Inter Tight\', -apple-system, BlinkMacSystemFont, sans-serif;\n\n        /* Motion Curves */\n        --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);\n        --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);\n      }\n\n      /* ==========================================================================\n         02. RESET & BASE DOCUMENT RULES\n         ========================================================================== */\n      *,\n      *::before,\n      *::after {\n        box-sizing: border-box;\n        margin: 0;\n        padding: 0;\n      }\n\n      html {\n        scroll-behavior: smooth;\n        background-color: var(--dark-bg);\n        color: var(--dark-text);\n        font-family: var(--font-sans);\n        font-size: 16px;\n        line-height: 1.5;\n        -webkit-font-smoothing: antialiased;\n        -moz-osx-font-smoothing: grayscale;\n        overflow-x: hidden;\n      }\n\n      body {\n        width: 100%;\n        min-height: 100vh;\n        overflow-x: hidden;\n        background-color: var(--dark-bg);\n      }\n\n      img,\n      svg {\n        display: block;\n        max-width: 100%;\n      }\n\n      button,\n      input,\n      select,\n      textarea {\n        font: inherit;\n        color: inherit;\n        background: none;\n        border: none;\n      }\n\n      button {\n        cursor: pointer;\n      }\n\n      a {\n        color: inherit;\n        text-decoration: none;\n      }\n\n      /* Accessible Focus States */\n      :focus-visible {\n        outline: 2px solid var(--accent);\n        outline-offset: 3px;\n      }\n\n      .sr-only {\n        position: absolute;\n        width: 1px;\n        height: 1px;\n        padding: 0;\n        margin: -1px;\n        overflow: hidden;\n        clip: rect(0, 0, 0, 0);\n        white-space: nowrap;\n        border: 0;\n      }\n\n      /* ==========================================================================\n         03. SECTION 01 \342\200\224 HERO / COMPANY INTRODUCTION (#DADADA)\n         ========================================================================== */\n      .hero-section {\n        position: relative;\n        width: 100%;\n        min-height: calc(938 * var(--u));\n        background-color: var(--hero-bg);\n        color: var(--hero-text);\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n        overflow: hidden;\n        border-bottom: 1px solid var(--hero-border);\n      }\n\n      /* Subtle architectural registration grid lines on Hero */\n      .hero-grid-overlay {\n        position: absolute;\n        inset: 0;\n        pointer-events: none;\n        z-index: 1;\n        background-image: linear-gradient(\n          to right,\n          rgba(17, 17, 17, 0.045) 1px,\n          transparent 1px\n        );\n        background-size: calc(360 * var(--u)) 100%;\n      }\n\n      .hero-container {\n        position: relative;\n        z-index: 2;\n        width: 100%;\n        max-width: 1440px;\n        margin: 0 auto;\n        padding: calc(28 * var(--u)) calc(44 * var(--u)) calc(32 * var(--u));\n        flex: 1;\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n      }\n\n      /* Top Bar: Upper-Left Pill Nav & Upper-Right Contact Action */\n      .top-bar {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 32px;\n        width: 100%;\n        padding-bottom: calc(20 * var(--u));\n        border-bottom: 1px solid var(--hero-border);\n      }\n\n      .nav-pill-shell {\n        position: relative;\n        display: inline-flex;\n        align-items: center;\n        background-color: var(--hero-surface);\n        padding: 4px;\n        border-radius: 999px;\n        border: 1px solid rgba(17, 17, 17, 0.1);\n      }\n\n      .nav-active-glider {\n        position: absolute;\n        top: 4px;\n        left: 4px;\n        height: calc(100% - 8px);\n        background-color: var(--hero-text);\n        border-radius: 999px;\n        transition:\n          transform 0.38s var(--ease-out-expo),\n          width 0.38s var(--ease-out-expo);\n        z-index: 1;\n        pointer-events: none;\n      }\n\n      .nav-link {\n        position: relative;\n        z-index: 2;\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        padding: 8px 20px;\n        font-family: var(--font-sans);\n        font-size: 13px;\n        font-weight: 500;\n        letter-spacing: 0.01em;\n        color: var(--hero-text);\n        white-space: nowrap;\n        transition: color 0.25s ease;\n        border-radius: 999px;\n      }\n\n      .nav-link[aria-current=\'true\'],\n      .nav-link.is-active {\n        color: #f4f4f4;\n      }\n\n      .nav-link:hover:not(.is-active) {\n        color: #000000;\n      }\n\n      .top-brand-descriptor {\n        display: flex;\n        align-items: center;\n        gap: 10px;\n        font-size: 12px;\n        font-weight: 500;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        color: var(--hero-text-secondary);\n        white-space: nowrap;\n      }\n\n      .top-brand-descriptor .descriptor-sep {\n        color: var(--hero-text-muted);\n      }\n\n      .contact-top-btn {\n        display: inline-flex;\n        align-items: center;\n        gap: 10px;\n        padding: 10px 22px;\n        background-color: var(--hero-text);\n        color: #f4f4f4;\n        font-family: var(--font-sans);\n        font-size: 13px;\n        font-weight: 500;\n        letter-spacing: 0.02em;\n        border-radius: 999px;\n        white-space: nowrap;\n        transition:\n          transform 0.18s var(--ease-out-expo),\n          background-color 0.18s ease,\n          box-shadow 0.18s ease;\n      }\n\n      .contact-top-btn:hover {\n        transform: translateY(-1px);\n        background-color: #222222;\n        box-shadow: 0 6px 18px rgba(17, 17, 17, 0.14);\n      }\n\n      .contact-top-btn .accent-indicator {\n        width: 6px;\n        height: 6px;\n        border-radius: 50%;\n        background-color: var(--accent);\n        display: inline-block;\n      }\n\n      /* Main Hero Editorial Stage (Asymmetrical 12-Column Composition) */\n      .hero-stage {\n        position: relative;\n        display: grid;\n        grid-template-columns: repeat(12, minmax(0, 1fr));\n        gap: calc(24 * var(--u));\n        align-items: stretch;\n        margin-top: calc(28 * var(--u));\n        margin-bottom: calc(24 * var(--u));\n        min-height: calc(680 * var(--u));\n      }\n\n      /* Left Column: Oversized Headline, Supporting Intro, Info Cards */\n      .hero-left {\n        grid-column: 1 / 6;\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n        z-index: 4;\n        padding-top: calc(12 * var(--u));\n      }\n\n      .hero-kicker-tag {\n        display: inline-flex;\n        align-items: center;\n        gap: 10px;\n        font-size: 12px;\n        font-weight: 600;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        color: var(--hero-text-secondary);\n        margin-bottom: calc(18 * var(--u));\n      }\n\n      .hero-kicker-line {\n        width: 28px;\n        height: 1px;\n        background-color: var(--hero-text);\n      }\n\n      .hero-headline {\n        font-family: var(--font-display);\n        font-weight: 900;\n        font-variation-settings: \'wdth\' 112;\n        font-size: clamp(3.4rem, calc(88 * var(--u)), 6.2rem);\n        line-height: 0.91;\n        letter-spacing: -0.035em;\n        text-transform: uppercase;\n        color: var(--hero-text);\n        margin-bottom: calc(26 * var(--u));\n      }\n\n      .headline-mask {\n        display: block;\n        overflow: hidden;\n        padding-bottom: 0.04em;\n      }\n\n      .headline-line {\n        display: block;\n        will-change: transform, opacity;\n      }\n\n      .hero-supporting-copy {\n        font-size: clamp(1rem, calc(17 * var(--u)), 1.15rem);\n        line-height: 1.55;\n        font-weight: 400;\n        color: var(--hero-text-secondary);\n        max-width: 40ch;\n        margin-bottom: calc(36 * var(--u));\n      }\n\n      /* Hero Information Cards (02+ Business Directions, 03 Selected Initiatives) */\n      .hero-info-cards {\n        display: grid;\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: calc(14 * var(--u));\n        max-width: calc(440 * var(--u));\n      }\n\n      .hero-stat-card {\n        position: relative;\n        text-align: left;\n        background-color: var(--hero-surface);\n        border: 1px solid var(--hero-border);\n        padding: calc(20 * var(--u)) calc(22 * var(--u));\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n        min-height: calc(132 * var(--u));\n        transition:\n          transform 0.18s var(--ease-out-expo),\n          background-color 0.18s ease,\n          border-color 0.18s ease;\n      }\n\n      .hero-stat-card:hover {\n        transform: translateY(-2px);\n        background-color: var(--hero-surface-hover);\n        border-color: var(--hero-border-strong);\n      }\n\n      .hero-stat-top {\n        display: flex;\n        align-items: baseline;\n        justify-content: space-between;\n        width: 100%;\n      }\n\n      .hero-stat-number {\n        font-family: var(--font-display);\n        font-weight: 800;\n        font-variation-settings: \'wdth\' 110;\n        font-size: clamp(2rem, calc(42 * var(--u)), 2.85rem);\n        line-height: 1;\n        letter-spacing: -0.03em;\n        color: var(--hero-text);\n        font-variant-numeric: tabular-nums;\n      }\n\n      .hero-stat-arrow {\n        font-size: 13px;\n        color: var(--hero-text-muted);\n        transition: transform 0.18s var(--ease-out-expo), color 0.18s ease;\n      }\n\n      .hero-stat-card:hover .hero-stat-arrow {\n        transform: translate(2px, -2px);\n        color: var(--hero-text);\n      }\n\n      .hero-stat-label {\n        font-size: 13px;\n        font-weight: 600;\n        letter-spacing: 0.01em;\n        color: var(--hero-text);\n        margin-top: calc(16 * var(--u));\n      }\n\n      .hero-stat-sub {\n        font-size: 11px;\n        color: var(--hero-text-muted);\n        margin-top: 2px;\n      }\n\n      /* Center Column: Cinematic Editorial Visual + Integrated Brand Identity Plate */\n      .hero-center-visual {\n        grid-column: 6 / 10;\n        position: relative;\n        display: flex;\n        flex-direction: column;\n        justify-content: flex-end;\n        align-items: center;\n        min-height: calc(640 * var(--u));\n        z-index: 3;\n      }\n\n      .hero-visual-frame {\n        position: relative;\n        width: 100%;\n        height: 100%;\n        min-height: calc(620 * var(--u));\n        background-color: var(--hero-surface);\n        border: 1px solid var(--hero-border);\n        overflow: hidden;\n        display: flex;\n        align-items: flex-end;\n        justify-content: center;\n      }\n\n      /* Architectural SVG Technical Grid & Silhouette Fallback inside Visual Frame */\n      .hero-visual-svg-backdrop {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        z-index: 1;\n        pointer-events: none;\n      }\n\n      .hero-portrait-img {\n        position: relative;\n        z-index: 2;\n        width: 100%;\n        height: 100%;\n        min-height: calc(620 * var(--u));\n        object-fit: cover;\n        object-position: center 22%;\n        filter: grayscale(100%) contrast(1.06) brightness(0.97);\n        mix-blend-mode: multiply;\n        will-change: transform;\n        transition: transform 0.2s ease-out;\n      }\n\n      /* Top and edge feather blend so portrait merges naturally into #DADADA/#CDCDCD */\n      .hero-visual-scrim {\n        position: absolute;\n        inset: 0;\n        z-index: 3;\n        pointer-events: none;\n        background:\n          linear-gradient(\n            to bottom,\n            rgba(218, 218, 218, 0.92) 0%,\n            rgba(218, 218, 218, 0.18) 16%,\n            transparent 38%,\n            rgba(17, 17, 17, 0.18) 78%,\n            rgba(17, 17, 17, 0.65) 100%\n          );\n      }\n\n      .hero-visual-telemetry {\n        position: absolute;\n        top: calc(16 * var(--u));\n        left: calc(18 * var(--u));\n        right: calc(18 * var(--u));\n        z-index: 4;\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        font-size: 11px;\n        font-weight: 600;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        color: var(--hero-text);\n        pointer-events: none;\n      }\n\n      /* Brand Identity Plate integrated into the visual */\n      .brand-identity-plate {\n        position: absolute;\n        left: calc(18 * var(--u));\n        right: calc(18 * var(--u));\n        bottom: calc(18 * var(--u));\n        z-index: 5;\n        background-color: rgba(17, 17, 17, 0.94);\n        color: #f4f4f4;\n        padding: calc(18 * var(--u)) calc(20 * var(--u));\n        border: 1px solid rgba(255, 255, 255, 0.16);\n        backdrop-filter: blur(8px);\n      }\n\n      .brand-plate-top {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 12px;\n        margin-bottom: 6px;\n      }\n\n      .brand-plate-name {\n        font-family: var(--font-display);\n        font-weight: 900;\n        font-variation-settings: \'wdth\' 118;\n        font-size: clamp(1.35rem, calc(26 * var(--u)), 1.75rem);\n        letter-spacing: 0.06em;\n        line-height: 1;\n        color: #f4f4f4;\n      }\n\n      .brand-plate-mark {\n        font-size: 10px;\n        font-weight: 600;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        color: var(--accent);\n      }\n\n      .brand-plate-descriptor {\n        font-size: 11px;\n        font-weight: 600;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        color: #a0a0a0;\n      }\n\n      .brand-plate-tagline {\n        margin-top: 10px;\n        padding-top: 10px;\n        border-top: 1px solid rgba(255, 255, 255, 0.14);\n        font-size: 12px;\n        color: #d8d8d8;\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n      }\n\n      /* Right Column: (ABOUT REKAVANTA), Short Description, CTAs, Architectural Spec */\n      .hero-right {\n        grid-column: 10 / 13;\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n        z-index: 4;\n        padding-top: calc(12 * var(--u));\n        border-left: 1px solid var(--hero-border);\n        padding-left: calc(24 * var(--u));\n      }\n\n      .hero-about-block {\n        display: flex;\n        flex-direction: column;\n        gap: calc(16 * var(--u));\n      }\n\n      .about-label {\n        font-size: 12px;\n        font-weight: 600;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        color: var(--hero-text);\n      }\n\n      .about-short-desc {\n        font-size: clamp(0.95rem, calc(15.5 * var(--u)), 1.05rem);\n        line-height: 1.6;\n        color: var(--hero-text-secondary);\n      }\n\n      .hero-cta-stack {\n        display: flex;\n        flex-direction: column;\n        gap: 10px;\n        margin-top: calc(8 * var(--u));\n      }\n\n      .btn-primary-hero {\n        display: inline-flex;\n        align-items: center;\n        justify-content: space-between;\n        width: 100%;\n        padding: 14px 18px;\n        background-color: var(--hero-text);\n        color: #f4f4f4;\n        font-size: 13px;\n        font-weight: 600;\n        letter-spacing: 0.02em;\n        white-space: nowrap;\n        transition:\n          transform 0.18s var(--ease-out-expo),\n          background-color 0.18s ease;\n      }\n\n      .btn-primary-hero:hover {\n        transform: translateY(-1px);\n        background-color: #242424;\n      }\n\n      .btn-secondary-hero {\n        display: inline-flex;\n        align-items: center;\n        justify-content: space-between;\n        width: 100%;\n        padding: 13px 18px;\n        background-color: transparent;\n        color: var(--hero-text);\n        border: 1px solid var(--hero-border-strong);\n        font-size: 13px;\n        font-weight: 600;\n        letter-spacing: 0.02em;\n        white-space: nowrap;\n        transition:\n          transform 0.18s var(--ease-out-expo),\n          background-color 0.18s ease,\n          border-color 0.18s ease;\n      }\n\n      .btn-secondary-hero:hover {\n        transform: translateY(-1px);\n        background-color: var(--hero-surface);\n        border-color: var(--hero-text);\n      }\n\n      /* Right-side Supporting Visual Information Block */\n      .hero-architecture-spec {\n        background-color: var(--hero-surface);\n        border: 1px solid var(--hero-border);\n        padding: calc(18 * var(--u));\n        display: flex;\n        flex-direction: column;\n        gap: 14px;\n      }\n\n      .spec-header {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        font-size: 11px;\n        font-weight: 600;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        color: var(--hero-text-secondary);\n        padding-bottom: 10px;\n        border-bottom: 1px solid var(--hero-border);\n      }\n\n      .spec-row {\n        display: flex;\n        align-items: baseline;\n        justify-content: space-between;\n        gap: 8px;\n        font-size: 12px;\n      }\n\n      .spec-key {\n        color: var(--hero-text-muted);\n      }\n\n      .spec-val {\n        font-weight: 600;\n        color: var(--hero-text);\n        text-align: right;\n      }\n\n      .spec-progress-rail {\n        width: 100%;\n        height: 2px;\n        background-color: rgba(17, 17, 17, 0.14);\n        position: relative;\n        overflow: hidden;\n      }\n\n      .spec-progress-fill {\n        position: absolute;\n        top: 0;\n        left: 0;\n        height: 100%;\n        width: 68%;\n        background-color: var(--hero-text);\n        transition: width 0.6s var(--ease-out-expo);\n      }\n\n      /* Bottom Hero Conceptual Domain Bar: SOFTWARE / PRODUCTS / INTELLIGENCE */\n      .hero-domain-strip {\n        padding-top: calc(20 * var(--u));\n        border-top: 1px solid var(--hero-border);\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 24px;\n        flex-wrap: wrap;\n      }\n\n      .domain-strip-caption {\n        font-size: 12px;\n        font-weight: 500;\n        color: var(--hero-text-muted);\n        letter-spacing: 0.02em;\n      }\n\n      .domain-labels-group {\n        display: flex;\n        align-items: center;\n        gap: calc(36 * var(--u));\n        flex-wrap: wrap;\n      }\n\n      .domain-concept-item {\n        display: inline-flex;\n        align-items: center;\n        gap: 10px;\n        font-family: var(--font-display);\n        font-size: 13px;\n        font-weight: 700;\n        letter-spacing: 0.12em;\n        text-transform: uppercase;\n        color: var(--hero-text);\n        padding: 6px 0;\n        border-bottom: 1px solid transparent;\n        transition: border-color 0.2s ease, color 0.2s ease;\n      }\n\n      .domain-concept-item:hover {\n        border-bottom-color: var(--hero-text);\n      }\n\n      .domain-index {\n        font-family: var(--font-sans);\n        font-size: 11px;\n        font-weight: 600;\n        color: var(--hero-text-muted);\n        font-variant-numeric: tabular-nums;\n      }\n\n      /* ==========================================================================\n         04. SECTION 02 \342\200\224 MANIFESTO / COMPANY PHILOSOPHY (#000000)\n         ========================================================================== */\n      .manifesto-section {\n        position: relative;\n        width: 100%;\n        background-color: var(--dark-bg);\n        color: var(--dark-text);\n        padding: calc(140 * var(--u)) calc(44 * var(--u));\n        border-bottom: 1px solid var(--dark-border);\n      }\n\n      .manifesto-container {\n        max-width: 1220px;\n        margin: 0 auto;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        text-align: center;\n      }\n\n      .manifesto-eyebrow {\n        display: inline-flex;\n        align-items: center;\n        gap: 12px;\n        font-size: 12px;\n        font-weight: 600;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        color: var(--dark-text-secondary);\n        margin-bottom: calc(44 * var(--u));\n      }\n\n      .manifesto-statement {\n        font-family: var(--font-display);\n        font-weight: 700;\n        font-variation-settings: \'wdth\' 104;\n        font-size: clamp(1.85rem, calc(46 * var(--u)), 3.25rem);\n        line-height: 1.24;\n        letter-spacing: -0.025em;\n        max-width: 23ch;\n        margin: 0 auto calc(48 * var(--u));\n        text-wrap: balance;\n      }\n\n      .manifesto-word {\n        display: inline-block;\n        color: #6f6f6f;\n        transition: color 0.08s linear;\n        margin-right: 0.22em;\n      }\n\n      .manifesto-supporting {\n        font-size: clamp(1.02rem, calc(18 * var(--u)), 1.2rem);\n        line-height: 1.6;\n        color: var(--dark-text-secondary);\n        max-width: 56ch;\n        margin-bottom: calc(56 * var(--u));\n      }\n\n      .manifesto-labels-row {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: calc(48 * var(--u));\n        width: 100%;\n        max-width: 720px;\n        padding-top: calc(32 * var(--u));\n        border-top: 1px solid var(--dark-border);\n      }\n\n      .manifesto-label-item {\n        display: inline-flex;\n        align-items: center;\n        gap: 10px;\n        font-family: var(--font-display);\n        font-size: 13px;\n        font-weight: 700;\n        letter-spacing: 0.16em;\n        text-transform: uppercase;\n        color: var(--dark-text);\n      }\n\n      .manifesto-label-num {\n        font-family: var(--font-sans);\n        font-size: 11px;\n        font-weight: 500;\n        color: var(--accent);\n        font-variant-numeric: tabular-nums;\n      }\n\n      /* ==========================================================================\n         05. SECTION 03 \342\200\224 OUR STUDIO / BUSINESS MODEL & SELECTED WORK (#000000)\n         ========================================================================== */\n      .studio-section {\n        position: relative;\n        width: 100%;\n        background-color: var(--dark-bg);\n        color: var(--dark-text);\n        padding: calc(100 * var(--u)) calc(44 * var(--u)) calc(64 * var(--u));\n      }\n\n      .studio-editorial-panel {\n        max-width: 1352px;\n        margin: 0 auto;\n        border: 1px solid var(--dark-border);\n        background-color: var(--dark-surface);\n      }\n\n      /* Studio Panel Header */\n      .studio-header-grid {\n        display: grid;\n        grid-template-columns: repeat(12, minmax(0, 1fr));\n        gap: calc(24 * var(--u));\n        padding: calc(56 * var(--u)) calc(48 * var(--u));\n        border-bottom: 1px solid var(--dark-border);\n        align-items: end;\n      }\n\n      .studio-header-left {\n        grid-column: 1 / 7;\n      }\n\n      .studio-section-tag {\n        font-size: 12px;\n        font-weight: 600;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        color: var(--accent);\n        margin-bottom: 16px;\n        display: block;\n      }\n\n      .studio-main-heading {\n        font-family: var(--font-display);\n        font-weight: 800;\n        font-variation-settings: \'wdth\' 108;\n        font-size: clamp(2.4rem, calc(58 * var(--u)), 4rem);\n        line-height: 0.98;\n        letter-spacing: -0.03em;\n        color: var(--dark-text);\n      }\n\n      .studio-header-right {\n        grid-column: 7 / 13;\n        display: flex;\n        flex-direction: column;\n        justify-content: flex-end;\n      }\n\n      .studio-supporting-copy {\n        font-size: clamp(1rem, calc(17 * var(--u)), 1.125rem);\n        line-height: 1.65;\n        color: var(--dark-text-secondary);\n        max-width: 54ch;\n      }\n\n      /* Two Business Pillars Grid */\n      .pillars-grid {\n        display: grid;\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        border-bottom: 1px solid var(--dark-border);\n      }\n\n      .pillar-card {\n        padding: calc(48 * var(--u));\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n        gap: calc(36 * var(--u));\n        transition: background-color 0.25s ease;\n      }\n\n      .pillar-card:first-child {\n        border-right: 1px solid var(--dark-border);\n      }\n\n      .pillar-card:hover {\n        background-color: var(--dark-surface-elevated);\n      }\n\n      .pillar-meta-top {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        padding-bottom: 18px;\n        border-bottom: 1px solid var(--dark-border);\n      }\n\n      .pillar-index {\n        font-size: 12px;\n        font-weight: 600;\n        letter-spacing: 0.12em;\n        text-transform: uppercase;\n        color: var(--dark-text-muted);\n        font-variant-numeric: tabular-nums;\n      }\n\n      .pillar-badge-direction {\n        font-size: 11px;\n        font-weight: 600;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        color: var(--accent);\n      }\n\n      .pillar-title {\n        font-family: var(--font-display);\n        font-weight: 800;\n        font-size: clamp(1.5rem, calc(30 * var(--u)), 2.1rem);\n        letter-spacing: -0.02em;\n        color: var(--dark-text);\n        margin-top: 22px;\n        margin-bottom: 14px;\n      }\n\n      .pillar-description {\n        font-size: 15.5px;\n        line-height: 1.6;\n        color: var(--dark-text-secondary);\n        max-width: 50ch;\n      }\n\n      .capabilities-list {\n        list-style: none;\n        display: flex;\n        flex-direction: column;\n        border-top: 1px solid var(--dark-border);\n      }\n\n      .capability-item {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        padding: 15px 0;\n        border-bottom: 1px solid var(--dark-border);\n        font-size: 15px;\n        font-weight: 500;\n        color: var(--dark-text);\n        transition: padding-left 0.2s var(--ease-out-expo), color 0.2s ease;\n      }\n\n      .capability-item:hover {\n        padding-left: 8px;\n        color: var(--accent);\n      }\n\n      .capability-num {\n        font-size: 12px;\n        color: var(--dark-text-muted);\n        font-variant-numeric: tabular-nums;\n        margin-right: 14px;\n      }\n\n      .capability-scope {\n        font-size: 12px;\n        color: var(--dark-text-muted);\n      }\n\n      .pillar-action-btn {\n        display: inline-flex;\n        align-items: center;\n        justify-content: space-between;\n        padding: 14px 20px;\n        border: 1px solid var(--dark-border-strong);\n        color: var(--dark-text);\n        font-size: 13px;\n        font-weight: 600;\n        letter-spacing: 0.03em;\n        white-space: nowrap;\n        transition:\n          transform 0.18s var(--ease-out-expo),\n          border-color 0.18s ease,\n          background-color 0.18s ease;\n      }\n\n      .pillar-action-btn:hover {\n        transform: translateY(-1px);\n        border-color: var(--accent);\n        background-color: rgba(125, 175, 224, 0.08);\n      }\n\n      /* Selected Initiatives Sub-Section (#work) */\n      .initiatives-wrapper {\n        padding: calc(56 * var(--u)) calc(48 * var(--u));\n        border-bottom: 1px solid var(--dark-border);\n      }\n\n      .initiatives-top-bar {\n        display: flex;\n        align-items: flex-end;\n        justify-content: space-between;\n        gap: 24px;\n        margin-bottom: calc(40 * var(--u));\n        flex-wrap: wrap;\n      }\n\n      .initiatives-heading-group {\n        display: flex;\n        flex-direction: column;\n        gap: 8px;\n      }\n\n      .initiatives-title {\n        font-family: var(--font-display);\n        font-weight: 800;\n        font-size: clamp(1.6rem, calc(32 * var(--u)), 2.25rem);\n        letter-spacing: -0.02em;\n        color: var(--dark-text);\n      }\n\n      .initiatives-subtitle {\n        font-size: 14px;\n        color: var(--dark-text-secondary);\n      }\n\n      /* Interactive Filter Controls for Initiatives */\n      .initiative-filter-group {\n        display: inline-flex;\n        align-items: center;\n        border: 1px solid var(--dark-border);\n        padding: 3px;\n        background-color: #050505;\n      }\n\n      .filter-tab-btn {\n        padding: 8px 16px;\n        font-size: 12px;\n        font-weight: 600;\n        letter-spacing: 0.04em;\n        color: var(--dark-text-secondary);\n        white-space: nowrap;\n        transition: background-color 0.18s ease, color 0.18s ease;\n      }\n\n      .filter-tab-btn.is-active {\n        background-color: var(--dark-text);\n        color: var(--dark-bg);\n      }\n\n      .filter-tab-btn:hover:not(.is-active) {\n        color: var(--dark-text);\n      }\n\n      .initiatives-cards-grid {\n        display: grid;\n        grid-template-columns: repeat(3, minmax(0, 1fr));\n        gap: calc(24 * var(--u));\n      }\n\n      .initiative-card {\n        border: 1px solid var(--dark-border);\n        background-color: #060606;\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n        transition:\n          transform 0.22s var(--ease-out-expo),\n          border-color 0.22s ease,\n          background-color 0.22s ease;\n      }\n\n      .initiative-card[hidden] {\n        display: none;\n      }\n\n      .initiative-card:hover {\n        transform: translateY(-4px);\n        border-color: var(--accent);\n        background-color: #0d0d0d;\n      }\n\n      .initiative-visual-box {\n        position: relative;\n        height: 196px;\n        border-bottom: 1px solid var(--dark-border);\n        background-color: #090909;\n        overflow: hidden;\n        padding: 20px;\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n      }\n\n      .initiative-visual-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        opacity: 0.78;\n        transition: transform 0.35s var(--ease-out-expo), opacity 0.35s ease;\n      }\n\n      .initiative-card:hover .initiative-visual-svg {\n        transform: scale(1.03);\n        opacity: 1;\n      }\n\n      .initiative-visual-top {\n        position: relative;\n        z-index: 2;\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        font-size: 11px;\n        font-weight: 600;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n      }\n\n      .initiative-index-label {\n        color: var(--dark-text-secondary);\n        font-variant-numeric: tabular-nums;\n      }\n\n      .initiative-status-label {\n        color: var(--accent);\n        letter-spacing: 0.1em;\n      }\n\n      .initiative-status-label.is-community {\n        color: #d4d4d4;\n      }\n\n      .initiative-body {\n        padding: calc(28 * var(--u));\n        flex: 1;\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n        gap: 24px;\n      }\n\n      .initiative-category {\n        font-size: 12px;\n        font-weight: 500;\n        color: var(--dark-text-muted);\n        margin-bottom: 8px;\n      }\n\n      .initiative-name {\n        font-family: var(--font-display);\n        font-weight: 800;\n        font-size: clamp(1.25rem, calc(22 * var(--u)), 1.5rem);\n        letter-spacing: -0.015em;\n        line-height: 1.2;\n        color: var(--dark-text);\n        margin-bottom: 14px;\n      }\n\n      .initiative-desc {\n        font-size: 14.5px;\n        line-height: 1.6;\n        color: var(--dark-text-secondary);\n      }\n\n      .initiative-footer {\n        padding-top: 16px;\n        border-top: 1px solid var(--dark-border);\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n      }\n\n      .initiative-inspect-btn {\n        display: inline-flex;\n        align-items: center;\n        gap: 8px;\n        font-size: 12.5px;\n        font-weight: 600;\n        letter-spacing: 0.03em;\n        color: var(--dark-text);\n        white-space: nowrap;\n        transition: color 0.18s ease;\n      }\n\n      .initiative-card:hover .initiative-inspect-btn {\n        color: var(--accent);\n      }\n\n      /* Final Call To Action Block */\n      .final-cta-block {\n        padding: calc(72 * var(--u)) calc(48 * var(--u));\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 32px;\n        flex-wrap: wrap;\n        background: linear-gradient(\n          180deg,\n          rgba(255, 255, 255, 0.015) 0%,\n          rgba(125, 175, 224, 0.04) 100%\n        );\n      }\n\n      .final-cta-copy-group {\n        max-width: 620px;\n      }\n\n      .final-cta-headline {\n        font-family: var(--font-display);\n        font-weight: 800;\n        font-variation-settings: \'wdth\' 108;\n        font-size: clamp(2rem, calc(46 * var(--u)), 3.25rem);\n        line-height: 1.05;\n        letter-spacing: -0.025em;\n        color: var(--dark-text);\n        margin-bottom: 14px;\n      }\n\n      .final-cta-supporting {\n        font-size: clamp(1rem, calc(17 * var(--u)), 1.125rem);\n        color: var(--dark-text-secondary);\n        line-height: 1.6;\n      }\n\n      .btn-final-cta {\n        display: inline-flex;\n        align-items: center;\n        gap: 14px;\n        padding: 18px 32px;\n        background-color: var(--dark-text);\n        color: var(--dark-bg);\n        font-family: var(--font-sans);\n        font-size: 14px;\n        font-weight: 700;\n        letter-spacing: 0.03em;\n        white-space: nowrap;\n        transition:\n          transform 0.18s var(--ease-out-expo),\n          background-color 0.18s ease;\n      }\n\n      .btn-final-cta:hover {\n        transform: translateY(-2px);\n        background-color: var(--accent);\n        color: #000000;\n      }\n\n      /* ==========================================================================\n         06. MINIMAL EDITORIAL FOOTER\n         ========================================================================== */\n      .site-footer {\n        max-width: 1352px;\n        margin: calc(48 * var(--u)) auto 0;\n        padding-top: calc(32 * var(--u));\n        border-top: 1px solid var(--dark-border);\n        display: grid;\n        grid-template-columns: repeat(12, minmax(0, 1fr));\n        gap: 24px;\n        font-size: 13px;\n        color: var(--dark-text-secondary);\n      }\n\n      .footer-brand-col {\n        grid-column: 1 / 5;\n        display: flex;\n        flex-direction: column;\n        gap: 6px;\n      }\n\n      .footer-brand-name {\n        font-family: var(--font-display);\n        font-weight: 900;\n        font-variation-settings: \'wdth\' 115;\n        font-size: 18px;\n        letter-spacing: 0.06em;\n        color: var(--dark-text);\n      }\n\n      .footer-brand-desc {\n        font-size: 12px;\n        color: var(--dark-text-muted);\n        letter-spacing: 0.04em;\n        text-transform: uppercase;\n      }\n\n      .footer-tagline {\n        margin-top: 8px;\n        font-size: 13px;\n        color: var(--dark-text-secondary);\n      }\n\n      .footer-nav-col {\n        grid-column: 5 / 8;\n        display: flex;\n        flex-direction: column;\n        gap: 8px;\n      }\n\n      .footer-col-label {\n        font-size: 11px;\n        font-weight: 600;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        color: var(--dark-text-muted);\n        margin-bottom: 4px;\n      }\n\n      .footer-links-list {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 18px;\n        list-style: none;\n      }\n\n      .footer-links-list a:hover {\n        color: var(--dark-text);\n        text-decoration: underline;\n      }\n\n      .footer-contact-col {\n        grid-column: 8 / 13;\n        display: flex;\n        flex-direction: column;\n        gap: 6px;\n      }\n\n      .footer-bottom-bar {\n        max-width: 1352px;\n        margin: 32px auto 0;\n        padding-top: 20px;\n        border-top: 1px solid rgba(255, 255, 255, 0.08);\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        font-size: 12px;\n        color: var(--dark-text-muted);\n        flex-wrap: wrap;\n        gap: 12px;\n      }\n\n      /* ==========================================================================\n         07. INTERACTIVE STUDIO DIALOGS (CONVERSATION DRAWER & INITIATIVE BRIEF)\n         ========================================================================== */\n      .modal-backdrop {\n        position: fixed;\n        inset: 0;\n        z-index: 100;\n        background-color: rgba(0, 0, 0, 0.78);\n        backdrop-filter: blur(6px);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 20px;\n        opacity: 0;\n        pointer-events: none;\n        transition: opacity 0.22s var(--ease-out-expo);\n      }\n\n      .modal-backdrop.is-open {\n        opacity: 1;\n        pointer-events: auto;\n      }\n\n      .studio-dialog {\n        width: 100%;\n        max-width: 640px;\n        background-color: #0b0b0b;\n        border: 1px solid var(--dark-border-strong);\n        color: var(--dark-text);\n        padding: 36px;\n        transform: translateY(12px);\n        transition: transform 0.24s var(--ease-out-expo);\n        max-height: 90vh;\n        overflow-y: auto;\n      }\n\n      .modal-backdrop.is-open .studio-dialog {\n        transform: translateY(0);\n      }\n\n      .dialog-header {\n        display: flex;\n        align-items: flex-start;\n        justify-content: space-between;\n        gap: 16px;\n        padding-bottom: 20px;\n        border-bottom: 1px solid var(--dark-border);\n        margin-bottom: 24px;\n      }\n\n      .dialog-kicker {\n        font-size: 11px;\n        font-weight: 600;\n        letter-spacing: 0.12em;\n        text-transform: uppercase;\n        color: var(--accent);\n        margin-bottom: 6px;\n        display: block;\n      }\n\n      .dialog-title {\n        font-family: var(--font-display);\n        font-size: 24px;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n        color: var(--dark-text);\n      }\n\n      .dialog-close-btn {\n        padding: 6px 12px;\n        border: 1px solid var(--dark-border);\n        font-size: 12px;\n        font-weight: 600;\n        color: var(--dark-text-secondary);\n        white-space: nowrap;\n      }\n\n      .dialog-close-btn:hover {\n        color: var(--dark-text);\n        border-color: var(--dark-text);\n      }\n\n      .inquiry-form {\n        display: flex;\n        flex-direction: column;\n        gap: 18px;\n      }\n\n      .form-field {\n        display: flex;\n        flex-direction: column;\n        gap: 6px;\n      }\n\n      .form-label {\n        font-size: 12px;\n        font-weight: 600;\n        letter-spacing: 0.04em;\n        text-transform: uppercase;\n        color: var(--dark-text-secondary);\n      }\n\n      .form-input,\n      .form-select,\n      .form-textarea {\n        width: 100%;\n        padding: 12px 14px;\n        background-color: #050505;\n        border: 1px solid var(--dark-border);\n        color: var(--dark-text);\n        font-size: 14px;\n        transition: border-color 0.18s ease;\n      }\n\n      .form-input:focus,\n      .form-select:focus,\n      .form-textarea:focus {\n        border-color: var(--accent);\n        outline: none;\n      }\n\n      .form-textarea {\n        min-height: 104px;\n        resize: vertical;\n      }\n\n      .field-error {\n        font-size: 12px;\n        color: #f87171;\n        min-height: 16px;\n      }\n\n      .form-submit-btn {\n        padding: 14px 24px;\n        background-color: var(--dark-text);\n        color: var(--dark-bg);\n        font-size: 13px;\n        font-weight: 700;\n        letter-spacing: 0.04em;\n        text-transform: uppercase;\n        transition: background-color 0.18s ease;\n      }\n\n      .form-submit-btn:hover {\n        background-color: var(--accent);\n      }\n\n      .inquiry-success-box {\n        padding: 24px;\n        border: 1px solid var(--accent);\n        background-color: rgba(125, 175, 224, 0.08);\n        display: flex;\n        flex-direction: column;\n        gap: 12px;\n      }\n\n      .brief-meta-grid {\n        display: grid;\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: 16px;\n        padding: 16px;\n        background-color: #050505;\n        border: 1px solid var(--dark-border);\n        margin-bottom: 20px;\n      }\n\n      .brief-section-list {\n        list-style: none;\n        display: flex;\n        flex-direction: column;\n        gap: 10px;\n        margin: 16px 0 24px;\n      }\n\n      .brief-section-list li {\n        padding-left: 16px;\n        position: relative;\n        font-size: 14px;\n        color: var(--dark-text-secondary);\n      }\n\n      .brief-section-list li::before {\n        content: \'\342\200\224\';\n        position: absolute;\n        left: 0;\n        color: var(--accent);\n      }\n\n      /* ==========================================================================\n         08. RESPONSIVE DESIGN (TABLET <= 1024px & MOBILE <= 760px)\n         ========================================================================== */\n      @media (max-width: 1024px) {\n        .hero-section {\n          min-height: auto;\n        }\n\n        .hero-stage {\n          grid-template-columns: repeat(12, minmax(0, 1fr));\n          min-height: auto;\n          gap: 24px;\n        }\n\n        .hero-left {\n          grid-column: 1 / 7;\n        }\n\n        .hero-center-visual {\n          grid-column: 7 / 13;\n          min-height: 520px;\n        }\n\n        .hero-right {\n          grid-column: 1 / 13;\n          border-left: none;\n          border-top: 1px solid var(--hero-border);\n          padding-left: 0;\n          padding-top: 24px;\n          display: grid;\n          grid-template-columns: repeat(2, minmax(0, 1fr));\n          gap: 24px;\n        }\n\n        .studio-header-grid {\n          grid-template-columns: 1fr;\n          gap: 20px;\n        }\n\n        .studio-header-left,\n        .studio-header-right {\n          grid-column: 1 / -1;\n        }\n\n        .pillars-grid {\n          grid-template-columns: 1fr;\n        }\n\n        .pillar-card:first-child {\n          border-right: none;\n          border-bottom: 1px solid var(--dark-border);\n        }\n\n        .initiatives-cards-grid {\n          grid-template-columns: repeat(2, minmax(0, 1fr));\n        }\n      }\n\n      @media (max-width: 760px) {\n        .hero-container {\n          padding: 16px 20px 28px;\n        }\n\n        .top-bar {\n          gap: 12px;\n          padding-bottom: 14px;\n        }\n\n        .top-brand-descriptor {\n          display: none;\n        }\n\n        .nav-link {\n          padding: 7px 13px;\n          font-size: 12px;\n        }\n\n        .contact-top-btn {\n          padding: 8px 14px;\n          font-size: 12px;\n        }\n\n        .hero-stage {\n          display: flex;\n          flex-direction: column;\n          gap: 28px;\n          margin-top: 20px;\n        }\n\n        .hero-left {\n          order: 1;\n        }\n\n        .hero-headline {\n          font-size: clamp(2.65rem, 12vw, 3.6rem);\n          margin-bottom: 16px;\n        }\n\n        .hero-supporting-copy {\n          margin-bottom: 24px;\n        }\n\n        .hero-info-cards {\n          max-width: 100%;\n          grid-template-columns: repeat(2, minmax(0, 1fr));\n          gap: 12px;\n        }\n\n        .hero-stat-card {\n          padding: 16px;\n          min-height: 110px;\n        }\n\n        .hero-center-visual {\n          order: 2;\n          width: 100%;\n          min-height: 440px;\n        }\n\n        .hero-visual-frame,\n        .hero-portrait-img {\n          min-height: 440px;\n        }\n\n        .hero-right {\n          order: 3;\n          display: flex;\n          flex-direction: column;\n          gap: 24px;\n        }\n\n        .hero-domain-strip {\n          flex-direction: column;\n          align-items: flex-start;\n          gap: 14px;\n        }\n\n        .domain-labels-group {\n          gap: 20px;\n        }\n\n        .manifesto-section {\n          padding: 72px 20px;\n        }\n\n        .manifesto-statement {\n          font-size: clamp(1.5rem, 6.5vw, 2.1rem);\n        }\n\n        .manifesto-labels-row {\n          flex-wrap: wrap;\n          gap: 20px;\n        }\n\n        .studio-section {\n          padding: 56px 20px 40px;\n        }\n\n        .studio-header-grid,\n        .pillar-card,\n        .initiatives-wrapper,\n        .final-cta-block {\n          padding: 28px 20px;\n        }\n\n        .initiatives-cards-grid {\n          grid-template-columns: 1fr;\n          gap: 20px;\n        }\n\n        .initiative-filter-group {\n          width: 100%;\n          overflow-x: auto;\n        }\n\n        .site-footer {\n          grid-template-columns: 1fr;\n          gap: 28px;\n        }\n\n        .footer-brand-col,\n        .footer-nav-col,\n        .footer-contact-col {\n          grid-column: 1 / -1;\n        }\n\n        .studio-dialog {\n          padding: 24px 20px;\n        }\n      }\n\n      /* Reduced Motion Support */\n      @media (prefers-reduced-motion: reduce) {\n        *,\n        *::before,\n        *::after {\n          animation-duration: 0.01ms !important;\n          animation-iteration-count: 1 !important;\n          transition-duration: 0.01ms !important;\n          scroll-behavior: auto !important;\n        }\n      }\n    </style>\n  </head>\n\n  <body>\n    <!-- ========================================================================\n         SECTION 01 \342\200\224 HERO / COMPANY INTRODUCTION\n         ======================================================================== -->\n    <section id=\"home\" class=\"hero-section\" aria-label=\"Company Introduction\">\n      <div class=\"hero-grid-overlay\" aria-hidden=\"true\"></div>\n\n      <div class=\"hero-container\">\n        <!-- Upper Navigation Bar -->\n        <header class=\"top-bar\">\n          <!-- Upper-Left Navigation Pill with Sliding Glider -->\n          <nav class=\"nav-pill-shell\" aria-label=\"Primary Navigation\">\n            <span id=\"nav-glider\" class=\"nav-active-glider\" aria-hidden=\"true\"></span>\n            <a href=\"#home\" class=\"nav-link is-active\" data-nav-target=\"home\" aria-current=\"true\">\n              Home\n            </a>\n            <a href=\"#studio\" class=\"nav-link\" data-nav-target=\"studio\">Studio</a>\n            <a href=\"#work\" class=\"nav-link\" data-nav-target=\"work\">Work</a>\n          </nav>\n\n          <!-- Center Subtle Identity Reference -->\n          <div class=\"top-brand-descriptor\" aria-hidden=\"true\">\n            <span>REKAVANTA</span>\n            <span class=\"descriptor-sep\">/</span>\n            <span>TECHNOLOGY &amp; PRODUCT STUDIO</span>\n          </div>\n\n          <!-- Upper-Right Contact Action -->\n          <button\n            type=\"button\"\n            class=\"contact-top-btn\"\n            data-open-contact=\"general\"\n            aria-haspopup=\"dialog\"\n          >\n            <span class=\"accent-indicator\" aria-hidden=\"true\"></span>\n            <span>Contact</span>\n          </button>\n        </header>\n\n        <!-- Main Asymmetrical Editorial Stage -->\n        <div class=\"hero-stage\">\n          <!-- Left Region: Oversized Headline, Supporting Copy, Info Cards -->\n          <div class=\"hero-left\">\n            <div>\n              <div class=\"hero-kicker-tag\">\n                <span class=\"hero-kicker-line\" aria-hidden=\"true\"></span>\n                <span>HYBRID TECHNOLOGY COMPANY</span>\n              </div>\n\n              <h1 class=\"hero-headline\">\n                <span class=\"headline-mask\">\n                  <span class=\"headline-line\" data-anim-line>BUILD</span>\n                </span>\n                <span class=\"headline-mask\">\n                  <span class=\"headline-line\" data-anim-line>WHAT\'S NEXT.</span>\n                </span>\n              </h1>\n\n              <p class=\"hero-supporting-copy\" data-anim-fade>\n                We engineer digital solutions and build independent products that turn ambitious\n                ideas into meaningful technology.\n              </p>\n            </div>\n\n            <!-- Two Business Information Cards -->\n            <div class=\"hero-info-cards\" data-anim-fade>\n              <a\n                href=\"#studio\"\n                class=\"hero-stat-card\"\n                aria-label=\"02+ Business Directions: Digital Services and Independent Digital Products\"\n              >\n                <div class=\"hero-stat-top\">\n                  <span class=\"hero-stat-number\">02+</span>\n                  <span class=\"hero-stat-arrow\" aria-hidden=\"true\">\342\206\227</span>\n                </div>\n                <div>\n                  <div class=\"hero-stat-label\">Business Directions</div>\n                  <div class=\"hero-stat-sub\">Services &amp; Independent Products</div>\n                </div>\n              </a>\n\n              <a\n                href=\"#work\"\n                class=\"hero-stat-card\"\n                aria-label=\"03 Selected Initiatives showcased in Our Studio\"\n              >\n                <div class=\"hero-stat-top\">\n                  <span class=\"hero-stat-number\">03</span>\n                  <span class=\"hero-stat-arrow\" aria-hidden=\"true\">\342\206\227</span>\n                </div>\n                <div>\n                  <div class=\"hero-stat-label\">Selected Initiatives</div>\n                  <div class=\"hero-stat-sub\">Concepts &amp; Community Systems</div>\n                </div>\n              </a>\n            </div>\n          </div>\n\n          <!-- Center Region: Monochromatic Editorial Visual & Brand Plate -->\n          <div class=\"hero-center-visual\" data-anim-visual>\n            <div class=\"hero-visual-frame\" id=\"hero-visual-frame\">\n              <!-- Architectural SVG Backdrop & Resilient Fallback -->\n              <svg\n                class=\"hero-visual-svg-backdrop\"\n                viewBox=\"0 0 480 640\"\n                fill=\"none\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n                aria-hidden=\"true\"\n              >\n                <line x1=\"0\" y1=\"96\" x2=\"480\" y2=\"96\" stroke=\"#111111\" stroke-opacity=\"0.1\" />\n                <line x1=\"0\" y1=\"460\" x2=\"480\" y2=\"460\" stroke=\"#111111\" stroke-opacity=\"0.1\" />\n                <line x1=\"96\" y1=\"0\" x2=\"96\" y2=\"640\" stroke=\"#111111\" stroke-opacity=\"0.08\" />\n                <line x1=\"384\" y1=\"0\" x2=\"384\" y2=\"640\" stroke=\"#111111\" stroke-opacity=\"0.08\" />\n                <circle\n                  cx=\"240\"\n                  cy=\"240\"\n                  r=\"136\"\n                  stroke=\"#111111\"\n                  stroke-opacity=\"0.12\"\n                  stroke-dasharray=\"3 3\"\n                />\n                <!-- Abstract architectural silhouette fallback if image is offline -->\n                <path\n                  d=\"M150 520 C154 410 185 355 240 355 C295 355 326 410 330 520 Z\"\n                  fill=\"#111111\"\n                  fill-opacity=\"0.16\"\n                />\n                <circle cx=\"240\" cy=\"240\" r=\"48\" fill=\"#111111\" fill-opacity=\"0.18\" />\n              </svg>\n\n              <img\n                src=\"/src/assets/images/rekavanta_hero_founder_1794122363916.jpg\"\n                alt=\"Monochromatic editorial portrait of a Rekavanta technology architect seen from behind\"\n                class=\"hero-portrait-img\"\n                id=\"hero-portrait-img\"\n                referrerpolicy=\"no-referrer\"\n              />\n\n              <div class=\"hero-visual-scrim\" aria-hidden=\"true\"></div>\n\n              <!-- Subtle Editorial Registration Marks -->\n              <div class=\"hero-visual-telemetry\" aria-hidden=\"true\">\n                <span>RKV // STUDIO PROFILE</span>\n                <span>01 \342\200\224 IDENTITY</span>\n              </div>\n\n              <!-- Integrated Brand Identity Plate -->\n              <div class=\"brand-identity-plate\" id=\"brand-plate\">\n                <div class=\"brand-plate-top\">\n                  <span class=\"brand-plate-name\">REKAVANTA</span>\n                  <span class=\"brand-plate-mark\">STUDIO</span>\n                </div>\n                <div class=\"brand-plate-descriptor\">TECHNOLOGY &amp; PRODUCT STUDIO</div>\n                <div class=\"brand-plate-tagline\">\n                  <span>Build Solutions. Create Possibilities.</span>\n                  <span aria-hidden=\"true\">01/03</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Right Region: (ABOUT REKAVANTA), Short Description, CTAs, Spec -->\n          <div class=\"hero-right\" data-anim-fade>\n            <div class=\"hero-about-block\">\n              <span class=\"about-label\">(ABOUT REKAVANTA)</span>\n              <p class=\"about-short-desc\">\n                Combining software engineering, digital innovation, and intelligent technology to\n                solve real-world problems.\n              </p>\n\n              <div class=\"hero-cta-stack\">\n                <a href=\"#studio\" class=\"btn-primary-hero\">\n                  <span>Explore Our Studio</span>\n                  <span aria-hidden=\"true\">\342\206\227</span>\n                </a>\n                <button\n                  type=\"button\"\n                  class=\"btn-secondary-hero\"\n                  data-open-contact=\"Start a Conversation\"\n                >\n                  <span>Start a Conversation</span>\n                  <span aria-hidden=\"true\">\342\206\227</span>\n                </button>\n              </div>\n            </div>\n\n            <!-- Supporting Visual Information on the Right Side -->\n            <div class=\"hero-architecture-spec\" aria-label=\"Studio Operating Model Overview\">\n              <div class=\"spec-header\">\n                <span>STUDIO MODEL</span>\n                <span>DUAL-ENGINE</span>\n              </div>\n              <div class=\"spec-row\">\n                <span class=\"spec-key\">Direction A</span>\n                <span class=\"spec-val\">Digital Services</span>\n              </div>\n              <div class=\"spec-row\">\n                <span class=\"spec-key\">Direction B</span>\n                <span class=\"spec-val\">Independent Products</span>\n              </div>\n              <div class=\"spec-row\">\n                <span class=\"spec-key\">Discipline</span>\n                <span class=\"spec-val\">Full-Stack &amp; AI Systems</span>\n              </div>\n              <div class=\"spec-progress-rail\" aria-hidden=\"true\">\n                <div class=\"spec-progress-fill\" id=\"hero-progress-bar\"></div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Horizontal Visual Separation & Conceptual Labels -->\n        <div class=\"hero-domain-strip\">\n          <span class=\"domain-strip-caption\">\n            Core Technological Foundations \342\200\224 Engineered for Clarity &amp; Scale\n          </span>\n          <div class=\"domain-labels-group\" role=\"list\" aria-label=\"Core Conceptual Domains\">\n            <a href=\"#pillar-services\" class=\"domain-concept-item\" role=\"listitem\">\n              <span class=\"domain-index\">01</span>\n              <span>SOFTWARE</span>\n            </a>\n            <a href=\"#pillar-products\" class=\"domain-concept-item\" role=\"listitem\">\n              <span class=\"domain-index\">02</span>\n              <span>PRODUCTS</span>\n            </a>\n            <a href=\"#work\" class=\"domain-concept-item\" role=\"listitem\">\n              <span class=\"domain-index\">03</span>\n              <span>INTELLIGENCE</span>\n            </a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ========================================================================\n         SECTION 02 \342\200\224 MANIFESTO / COMPANY PHILOSOPHY\n         ======================================================================== -->\n    <main>\n      <section\n        id=\"manifesto\"\n        class=\"manifesto-section\"\n        aria-labelledby=\"manifesto-heading\"\n      >\n        <div class=\"manifesto-container\">\n          <div class=\"manifesto-eyebrow\" id=\"manifesto-heading\">\n            <span>(02 \342\200\224 BRAND PHILOSOPHY)</span>\n          </div>\n\n          <!-- Centered 5-line Statement with Word-by-Word Spans -->\n          <p\n            id=\"manifesto-statement\"\n            class=\"manifesto-statement\"\n            aria-label=\"Technology should do more than just work. It should solve problems, remove friction, unlock new possibilities, and turn ambitious ideas into meaningful digital products.\"\n          >\n            <span class=\"manifesto-word\">Technology</span>\n            <span class=\"manifesto-word\">should</span>\n            <span class=\"manifesto-word\">do</span>\n            <span class=\"manifesto-word\">more</span>\n            <span class=\"manifesto-word\">than</span>\n            <span class=\"manifesto-word\">just</span>\n            <span class=\"manifesto-word\">work.</span>\n            <span class=\"manifesto-word\">It</span>\n            <span class=\"manifesto-word\">should</span>\n            <span class=\"manifesto-word\">solve</span>\n            <span class=\"manifesto-word\">problems,</span>\n            <span class=\"manifesto-word\">remove</span>\n            <span class=\"manifesto-word\">friction,</span>\n            <span class=\"manifesto-word\">unlock</span>\n            <span class=\"manifesto-word\">new</span>\n            <span class=\"manifesto-word\">possibilities,</span>\n            <span class=\"manifesto-word\">and</span>\n            <span class=\"manifesto-word\">turn</span>\n            <span class=\"manifesto-word\">ambitious</span>\n            <span class=\"manifesto-word\">ideas</span>\n            <span class=\"manifesto-word\">into</span>\n            <span class=\"manifesto-word\">meaningful</span>\n            <span class=\"manifesto-word\">digital</span>\n            <span class=\"manifesto-word\">products.</span>\n          </p>\n\n          <p class=\"manifesto-supporting\">\n            From custom software solutions to independent digital products. Engineered with\n            purpose. Built to evolve.\n          </p>\n\n          <!-- Three Small Editorial Labels -->\n          <div class=\"manifesto-labels-row\" role=\"list\" aria-label=\"Philosophy Pillars\">\n            <div class=\"manifesto-label-item\" role=\"listitem\">\n              <span class=\"manifesto-label-num\">01</span>\n              <span>ENGINEERING</span>\n            </div>\n            <div class=\"manifesto-label-item\" role=\"listitem\">\n              <span class=\"manifesto-label-num\">02</span>\n              <span>INNOVATION</span>\n            </div>\n            <div class=\"manifesto-label-item\" role=\"listitem\">\n              <span class=\"manifesto-label-num\">03</span>\n              <span>IMPACT</span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- ======================================================================\n           SECTION 03 \342\200\224 OUR STUDIO / BUSINESS MODEL & SELECTED WORK\n           ====================================================================== -->\n      <section id=\"studio\" class=\"studio-section\" aria-labelledby=\"studio-main-heading\">\n        <div class=\"studio-editorial-panel\">\n          <!-- Studio Section Header -->\n          <div class=\"studio-header-grid\">\n            <div class=\"studio-header-left\">\n              <span class=\"studio-section-tag\">(03 \342\200\224 OUR STUDIO &amp; BUSINESS MODEL)</span>\n              <h2 id=\"studio-main-heading\" class=\"studio-main-heading\">\n                Two engines.<br />One direction.\n              </h2>\n            </div>\n            <div class=\"studio-header-right\">\n              <p class=\"studio-supporting-copy\">\n                We combine professional technology services with independent product development,\n                creating solutions that solve immediate challenges while building possibilities for\n                the future.\n              </p>\n            </div>\n          </div>\n\n          <!-- Two Visually Distinct Business Pillars -->\n          <div class=\"pillars-grid\">\n            <!-- PILLAR 01 \342\200\224 DIGITAL SERVICES -->\n            <article id=\"pillar-services\" class=\"pillar-card\">\n              <div>\n                <div class=\"pillar-meta-top\">\n                  <span class=\"pillar-index\">PILLAR 01</span>\n                  <span class=\"pillar-badge-direction\">CLIENT PARTNERSHIPS</span>\n                </div>\n                <h3 class=\"pillar-title\">DIGITAL SERVICES</h3>\n                <p class=\"pillar-description\">\n                  We design and engineer tailored digital solutions that help businesses and\n                  organizations operate, innovate, and grow.\n                </p>\n              </div>\n\n              <ul class=\"capabilities-list\" aria-label=\"Digital Services Capabilities\">\n                <li class=\"capability-item\">\n                  <span><span class=\"capability-num\">01</span>Software Development</span>\n                  <span class=\"capability-scope\">Custom Architecture</span>\n                </li>\n                <li class=\"capability-item\">\n                  <span><span class=\"capability-num\">02</span>Web &amp; Mobile Applications</span>\n                  <span class=\"capability-scope\">Cross-Platform Systems</span>\n                </li>\n                <li class=\"capability-item\">\n                  <span><span class=\"capability-num\">03</span>AI Integration</span>\n                  <span class=\"capability-scope\">Intelligent Workflows</span>\n                </li>\n                <li class=\"capability-item\">\n                  <span><span class=\"capability-num\">04</span>Business Automation</span>\n                  <span class=\"capability-scope\">Process Optimization</span>\n                </li>\n                <li class=\"capability-item\">\n                  <span><span class=\"capability-num\">05</span>UI/UX Engineering</span>\n                  <span class=\"capability-scope\">Design Systems</span>\n                </li>\n              </ul>\n\n              <button\n                type=\"button\"\n                class=\"pillar-action-btn\"\n                data-open-contact=\"Digital Services \342\200\224 Custom Engineering\"\n              >\n                <span>Discuss a Service Engagement</span>\n                <span aria-hidden=\"true\">\342\206\227</span>\n              </button>\n            </article>\n\n            <!-- PILLAR 02 \342\200\224 DIGITAL PRODUCTS -->\n            <article id=\"pillar-products\" class=\"pillar-card\">\n              <div>\n                <div class=\"pillar-meta-top\">\n                  <span class=\"pillar-index\">PILLAR 02</span>\n                  <span class=\"pillar-badge-direction\">INTERNAL VENTURES</span>\n                </div>\n                <h3 class=\"pillar-title\">DIGITAL PRODUCTS</h3>\n                <p class=\"pillar-description\">\n                  We explore, design, and develop independent digital products built to solve\n                  everyday problems and create long-term value.\n                </p>\n              </div>\n\n              <ul class=\"capabilities-list\" aria-label=\"Digital Products Focus Areas\">\n                <li class=\"capability-item\">\n                  <span><span class=\"capability-num\">01</span>SaaS Platforms</span>\n                  <span class=\"capability-scope\">Vertical Software</span>\n                </li>\n                <li class=\"capability-item\">\n                  <span><span class=\"capability-num\">02</span>Business Applications</span>\n                  <span class=\"capability-scope\">Operational Suites</span>\n                </li>\n                <li class=\"capability-item\">\n                  <span><span class=\"capability-num\">03</span>Productivity Tools</span>\n                  <span class=\"capability-scope\">Personal &amp; Team Systems</span>\n                </li>\n                <li class=\"capability-item\">\n                  <span><span class=\"capability-num\">04</span>AI-powered Software</span>\n                  <span class=\"capability-scope\">Applied Intelligence</span>\n                </li>\n              </ul>\n\n              <button\n                type=\"button\"\n                class=\"pillar-action-btn\"\n                data-open-contact=\"Independent Digital Products\"\n              >\n                <span>Inquire About Product Initiatives</span>\n                <span aria-hidden=\"true\">\342\206\227</span>\n              </button>\n            </article>\n          </div>\n\n          <!-- SELECTED INITIATIVES (#work) -->\n          <div id=\"work\" class=\"initiatives-wrapper\">\n            <div class=\"initiatives-top-bar\">\n              <div class=\"initiatives-heading-group\">\n                <span class=\"studio-section-tag\">SELECTED INITIATIVES</span>\n                <h3 class=\"initiatives-title\">Engineered Concepts &amp; Community Systems</h3>\n                <p class=\"initiatives-subtitle\">\n                  Selected studio initiatives across proprietary product concepts and community\n                  digitalization.\n                </p>\n              </div>\n\n              <!-- Interactive Filter Buttons -->\n              <div\n                class=\"initiative-filter-group\"\n                role=\"group\"\n                aria-label=\"Filter Selected Initiatives\"\n              >\n                <button\n                  type=\"button\"\n                  class=\"filter-tab-btn is-active\"\n                  data-filter=\"all\"\n                  aria-pressed=\"true\"\n                >\n                  All Initiatives (03)\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"filter-tab-btn\"\n                  data-filter=\"PRODUCT CONCEPT\"\n                  aria-pressed=\"false\"\n                >\n                  Product Concepts (02)\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"filter-tab-btn\"\n                  data-filter=\"COMMUNITY PROJECT\"\n                  aria-pressed=\"false\"\n                >\n                  Community Project (01)\n                </button>\n              </div>\n            </div>\n\n            <div class=\"initiatives-cards-grid\" id=\"initiatives-grid\">\n              <!-- PROJECT 01 \342\200\224 HUNI -->\n              <article\n                class=\"initiative-card\"\n                data-category-type=\"PRODUCT CONCEPT\"\n                data-project-id=\"huni\"\n              >\n                <div class=\"initiative-visual-box\">\n                  <svg\n                    class=\"initiative-visual-svg\"\n                    viewBox=\"0 0 400 200\"\n                    fill=\"none\"\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    aria-hidden=\"true\"\n                  >\n                    <rect\n                      x=\"24\"\n                      y=\"52\"\n                      width=\"352\"\n                      height=\"124\"\n                      stroke=\"#FFFFFF\"\n                      stroke-opacity=\"0.16\"\n                    />\n                    <line\n                      x1=\"24\"\n                      y1=\"88\"\n                      x2=\"376\"\n                      y2=\"88\"\n                      stroke=\"#FFFFFF\"\n                      stroke-opacity=\"0.14\"\n                    />\n                    <line\n                      x1=\"140\"\n                      y1=\"52\"\n                      x2=\"140\"\n                      y2=\"176\"\n                      stroke=\"#FFFFFF\"\n                      stroke-opacity=\"0.14\"\n                    />\n                    <line\n                      x1=\"260\"\n                      y1=\"52\"\n                      x2=\"260\"\n                      y2=\"176\"\n                      stroke=\"#FFFFFF\"\n                      stroke-opacity=\"0.14\"\n                    />\n                    <rect\n                      x=\"40\"\n                      y=\"104\"\n                      width=\"84\"\n                      height=\"56\"\n                      stroke=\"#7DAFE0\"\n                      stroke-opacity=\"0.55\"\n                    />\n                    <rect\n                      x=\"156\"\n                      y=\"104\"\n                      width=\"88\"\n                      height=\"56\"\n                      stroke=\"#FFFFFF\"\n                      stroke-opacity=\"0.22\"\n                    />\n                    <rect\n                      x=\"276\"\n                      y=\"104\"\n                      width=\"84\"\n                      height=\"56\"\n                      stroke=\"#FFFFFF\"\n                      stroke-opacity=\"0.22\"\n                    />\n                  </svg>\n                  <div class=\"initiative-visual-top\">\n                    <span class=\"initiative-index-label\">PROJECT 01</span>\n                    <span class=\"initiative-status-label\">PRODUCT CONCEPT</span>\n                  </div>\n                </div>\n\n                <div class=\"initiative-body\">\n                  <div>\n                    <div class=\"initiative-category\">Property Management / SaaS</div>\n                    <h4 class=\"initiative-name\">HUNI</h4>\n                    <p class=\"initiative-desc\">\n                      A digital property management platform designed to simplify boarding house\n                      operations, tenant management, billing, and reporting.\n                    </p>\n                  </div>\n\n                  <div class=\"initiative-footer\">\n                    <button\n                      type=\"button\"\n                      class=\"initiative-inspect-btn\"\n                      data-inspect-project=\"huni\"\n                    >\n                      <span>View Initiative Brief</span>\n                      <span aria-hidden=\"true\">\342\206\227</span>\n                    </button>\n                  </div>\n                </div>\n              </article>\n\n              <!-- PROJECT 02 \342\200\224 PERSONAL OS -->\n              <article\n                class=\"initiative-card\"\n                data-category-type=\"PRODUCT CONCEPT\"\n                data-project-id=\"personal-os\"\n              >\n                <div class=\"initiative-visual-box\">\n                  <svg\n                    class=\"initiative-visual-svg\"\n                    viewBox=\"0 0 400 200\"\n                    fill=\"none\"\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    aria-hidden=\"true\"\n                  >\n                    <circle\n                      cx=\"200\"\n                      cy=\"112\"\n                      r=\"58\"\n                      stroke=\"#FFFFFF\"\n                      stroke-opacity=\"0.18\"\n                    />\n                    <circle\n                      cx=\"200\"\n                      cy=\"112\"\n                      r=\"34\"\n                      stroke=\"#7DAFE0\"\n                      stroke-opacity=\"0.6\"\n                      stroke-dasharray=\"4 4\"\n                    />\n                    <line\n                      x1=\"40\"\n                      y1=\"112\"\n                      x2=\"360\"\n                      y2=\"112\"\n                      stroke=\"#FFFFFF\"\n                      stroke-opacity=\"0.12\"\n                    />\n                    <line\n                      x1=\"200\"\n                      y1=\"44\"\n                      x2=\"200\"\n                      y2=\"180\"\n                      stroke=\"#FFFFFF\"\n                      stroke-opacity=\"0.12\"\n                    />\n                  </svg>\n                  <div class=\"initiative-visual-top\">\n                    <span class=\"initiative-index-label\">PROJECT 02</span>\n                    <span class=\"initiative-status-label\">PRODUCT CONCEPT</span>\n                  </div>\n                </div>\n\n                <div class=\"initiative-body\">\n                  <div>\n                    <div class=\"initiative-category\">Productivity / Personal Software</div>\n                    <h4 class=\"initiative-name\">PERSONAL OS</h4>\n                    <p class=\"initiative-desc\">\n                      A personal productivity system designed to help individuals manage tasks,\n                      energy, goals, and daily progress.\n                    </p>\n                  </div>\n\n                  <div class=\"initiative-footer\">\n                    <button\n                      type=\"button\"\n                      class=\"initiative-inspect-btn\"\n                      data-inspect-project=\"personal-os\"\n                    >\n                      <span>View Initiative Brief</span>\n                      <span aria-hidden=\"true\">\342\206\227</span>\n                    </button>\n                  </div>\n                </div>\n              </article>\n\n              <!-- PROJECT 03 \342\200\224 SENTUL TREKKING INFORMATION SYSTEM -->\n              <article\n                class=\"initiative-card\"\n                data-category-type=\"COMMUNITY PROJECT\"\n                data-project-id=\"sentul-trekking\"\n              >\n                <div class=\"initiative-visual-box\">\n                  <svg\n                    class=\"initiative-visual-svg\"\n                    viewBox=\"0 0 400 200\"\n                    fill=\"none\"\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                    aria-hidden=\"true\"\n                  >\n                    <path\n                      d=\"M28 164 L118 76 L188 136 L274 62 L372 164 Z\"\n                      stroke=\"#FFFFFF\"\n                      stroke-opacity=\"0.22\"\n                      fill=\"none\"\n                    />\n                    <path\n                      d=\"M64 164 C130 148 180 100 274 62\"\n                      stroke=\"#7DAFE0\"\n                      stroke-opacity=\"0.65\"\n                      stroke-dasharray=\"3 3\"\n                      fill=\"none\"\n                    />\n                    <circle cx=\"274\" cy=\"62\" r=\"4\" fill=\"#7DAFE0\" />\n                  </svg>\n                  <div class=\"initiative-visual-top\">\n                    <span class=\"initiative-index-label\">PROJECT 03</span>\n                    <span class=\"initiative-status-label is-community\">COMMUNITY PROJECT</span>\n                  </div>\n                </div>\n\n                <div class=\"initiative-body\">\n                  <div>\n                    <div class=\"initiative-category\">\n                      Community Digitalization / Web Development\n                    </div>\n                    <h4 class=\"initiative-name\">SENTUL TREKKING INFORMATION SYSTEM</h4>\n                    <p class=\"initiative-desc\">\n                      A community-oriented information platform providing trekking destination\n                      information and booking contact access.\n                    </p>\n                  </div>\n\n                  <div class=\"initiative-footer\">\n                    <button\n                      type=\"button\"\n                      class=\"initiative-inspect-btn\"\n                      data-inspect-project=\"sentul-trekking\"\n                    >\n                      <span>View Initiative Brief</span>\n                      <span aria-hidden=\"true\">\342\206\227</span>\n                    </button>\n                  </div>\n                </div>\n              </article>\n            </div>\n          </div>\n\n          <!-- FINAL CALL TO ACTION -->\n          <div class=\"final-cta-block\">\n            <div class=\"final-cta-copy-group\">\n              <h3 class=\"final-cta-headline\">Have an idea worth building?</h3>\n              <p class=\"final-cta-supporting\">\n                Let\'s explore how technology can turn your ideas into meaningful solutions.\n              </p>\n            </div>\n\n            <button\n              type=\"button\"\n              class=\"btn-final-cta\"\n              data-open-contact=\"Let\'s Build Together\"\n            >\n              <span>Let\'s Build Together</span>\n              <span aria-hidden=\"true\">\342\206\227</span>\n            </button>\n          </div>\n        </div>\n\n        <!-- Minimal Footer -->\n        <footer class=\"site-footer\" aria-label=\"Footer\">\n          <div class=\"footer-brand-col\">\n            <div class=\"footer-brand-name\">REKAVANTA</div>\n            <div class=\"footer-brand-desc\">Technology &amp; Product Studio</div>\n            <div class=\"footer-tagline\">Build Solutions. Create Possibilities.</div>\n          </div>\n\n          <div class=\"footer-nav-col\">\n            <span class=\"footer-col-label\">Navigation</span>\n            <ul class=\"footer-links-list\">\n              <li><a href=\"#home\">Home</a></li>\n              <li><a href=\"#manifesto\">Philosophy</a></li>\n              <li><a href=\"#studio\">Studio</a></li>\n              <li><a href=\"#work\">Work</a></li>\n              <li>\n                <button\n                  type=\"button\"\n                  data-open-contact=\"Footer Inquiry\"\n                  style=\"text-decoration: underline\"\n                >\n                  Contact\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          <div class=\"footer-contact-col\">\n            <span class=\"footer-col-label\">Contact (Placeholders \342\200\224 Replace with Verified Details)</span>\n            <div>Email: [contact-email@rekavanta-placeholder.tld]</div>\n            <div>Location: [Studio Location / Operational Region Placeholder]</div>\n          </div>\n        </footer>\n\n        <div class=\"footer-bottom-bar\">\n          <span>&copy; 2026 REKAVANTA. Technology &amp; Product Studio. All rights reserved.</span>\n          <span>Information Technology &amp; Software Development</span>\n        </div>\n      </section>\n    </main>\n\n    <!-- ========================================================================\n         INTERACTIVE MODAL 01: START A CONVERSATION / CONTACT INQUIRY\n         ======================================================================== -->\n    <div\n      id=\"contact-modal-backdrop\"\n      class=\"modal-backdrop\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"contact-dialog-title\"\n      aria-hidden=\"true\"\n    >\n      <div class=\"studio-dialog\">\n        <div class=\"dialog-header\">\n          <div>\n            <span class=\"dialog-kicker\">REKAVANTA STUDIO INQUIRY</span>\n            <h3 id=\"contact-dialog-title\" class=\"dialog-title\">Start a Conversation</h3>\n          </div>\n          <button\n            type=\"button\"\n            class=\"dialog-close-btn\"\n            id=\"close-contact-modal\"\n            aria-label=\"Close conversation dialog\"\n          >\n            Close \342\234\225\n          </button>\n        </div>\n\n        <form id=\"studio-inquiry-form\" class=\"inquiry-form\" novalidate>\n          <div class=\"form-field\">\n            <label for=\"inquiry-name\" class=\"form-label\">Your Name</label>\n            <input\n              id=\"inquiry-name\"\n              name=\"name\"\n              type=\"text\"\n              class=\"form-input\"\n              placeholder=\"e.g. Aksan Zulkarnain\"\n              required\n            />\n            <span class=\"field-error\" id=\"error-name\" role=\"alert\"></span>\n          </div>\n\n          <div class=\"form-field\">\n            <label for=\"inquiry-email\" class=\"form-label\">Email Address</label>\n            <input\n              id=\"inquiry-email\"\n              name=\"email\"\n              type=\"email\"\n              class=\"form-input\"\n              placeholder=\"name@organization.com\"\n              required\n            />\n            <span class=\"field-error\" id=\"error-email\" role=\"alert\"></span>\n          </div>\n\n          <div class=\"form-field\">\n            <label for=\"inquiry-direction\" class=\"form-label\">Business Direction / Topic</label>\n            <select id=\"inquiry-direction\" name=\"direction\" class=\"form-select\" required>\n              <option value=\"\">Select a direction...</option>\n              <option value=\"Digital Services \342\200\224 Custom Engineering\">\n                Digital Services \342\200\224 Custom Software, Web/Mobile &amp; AI\n              </option>\n              <option value=\"Independent Digital Products\">\n                Independent Digital Products \342\200\224 SaaS &amp; Product Concepts\n              </option>\n              <option value=\"Initiative Inquiry \342\200\224 HUNI / PERSONAL OS / SENTUL\">\n                Selected Initiative Inquiry (HUNI / Personal OS / Sentul Trekking)\n              </option>\n              <option value=\"General Studio Conversation\">General Studio Conversation</option>\n            </select>\n            <span class=\"field-error\" id=\"error-direction\" role=\"alert\"></span>\n          </div>\n\n          <div class=\"form-field\">\n            <label for=\"inquiry-message\" class=\"form-label\">Project or Idea Overview</label>\n            <textarea\n              id=\"inquiry-message\"\n              name=\"message\"\n              class=\"form-textarea\"\n              placeholder=\"Tell us about the problem you are solving or the digital product you want to build...\"\n              required\n            ></textarea>\n            <span class=\"field-error\" id=\"error-message\" role=\"alert\"></span>\n          </div>\n\n          <button type=\"submit\" class=\"form-submit-btn\">Send Studio Inquiry \342\206\227</button>\n        </form>\n\n        <div id=\"inquiry-confirmation\" class=\"inquiry-success-box\" hidden>\n          <div style=\"font-weight: 700; font-size: 16px; color: #f4f4f4\">\n            Inquiry Logged for Review\n          </div>\n          <p id=\"inquiry-confirmation-text\" style=\"font-size: 14px; color: #a0a0a0\"></p>\n          <button\n            type=\"button\"\n            class=\"dialog-close-btn\"\n            id=\"reset-inquiry-btn\"\n            style=\"align-self: flex-start; margin-top: 8px\"\n          >\n            Submit Another Note\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ========================================================================\n         INTERACTIVE MODAL 02: INITIATIVE SPECIFICATION BRIEF\n         ======================================================================== -->\n    <div\n      id=\"project-modal-backdrop\"\n      class=\"modal-backdrop\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"project-dialog-title\"\n      aria-hidden=\"true\"\n    >\n      <div class=\"studio-dialog\">\n        <div class=\"dialog-header\">\n          <div>\n            <span id=\"project-dialog-status\" class=\"dialog-kicker\">PRODUCT CONCEPT</span>\n            <h3 id=\"project-dialog-title\" class=\"dialog-title\">HUNI</h3>\n          </div>\n          <button\n            type=\"button\"\n            class=\"dialog-close-btn\"\n            id=\"close-project-modal\"\n            aria-label=\"Close initiative brief dialog\"\n          >\n            Close \342\234\225\n          </button>\n        </div>\n\n        <div class=\"brief-meta-grid\">\n          <div>\n            <div class=\"form-label\">Category</div>\n            <div id=\"project-dialog-category\" style=\"font-size: 14px; margin-top: 4px\">\n              Property Management / SaaS\n            </div>\n          </div>\n          <div>\n            <div class=\"form-label\">Classification</div>\n            <div id=\"project-dialog-classification\" style=\"font-size: 14px; margin-top: 4px\">\n              Independent Product Concept\n            </div>\n          </div>\n        </div>\n\n        <p\n          id=\"project-dialog-description\"\n          style=\"font-size: 15px; line-height: 1.65; color: #d8d8d8\"\n        ></p>\n\n        <div style=\"margin-top: 20px\">\n          <div class=\"form-label\">Architectural Focus Areas</div>\n          <ul id=\"project-dialog-focus\" class=\"brief-section-list\"></ul>\n        </div>\n\n        <button\n          type=\"button\"\n          class=\"form-submit-btn\"\n          id=\"project-dialog-inquire-btn\"\n          style=\"width: 100%\"\n        >\n          Discuss This Initiative With Rekavanta \342\206\227\n        </button>\n      </div>\n    </div>\n\n    <!-- ========================================================================\n         EMBEDDED VANILLA JAVASCRIPT (MOTION, SCROLL REVEAL, NAVIGATION, MODALS)\n         ======================================================================== -->\n    <script>\n      (function () {\n        \'use strict\';\n\n        const prefersReducedMotion = window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches;\n        const urlParams = new URLSearchParams(window.location.search);\n        const isRecordingMode = urlParams.get(\'rec\') === \'1\';\n\n        /* ----------------------------------------------------------------------\n           1. PAGE LOAD ENTRANCE ANIMATION (Web Animations API)\n           ---------------------------------------------------------------------- */\n        function runEntranceAnimations() {\n          if (prefersReducedMotion) return;\n\n          const headlineLines = document.querySelectorAll(\'[data-anim-line]\');\n          headlineLines.forEach((line, index) => {\n            line.animate(\n              [\n                { transform: \'translateY(105%)\', opacity: 0 },\n                { transform: \'translateY(0%)\', opacity: 1 },\n              ],\n              {\n                duration: 820,\n                delay: 80 + index * 110,\n                easing: \'cubic-bezier(0.16, 1, 0.3, 1)\',\n                fill: \'both\',\n              }\n            );\n          });\n\n          const heroVisual = document.querySelector(\'[data-anim-visual]\');\n          if (heroVisual) {\n            heroVisual.animate(\n              [\n                { transform: \'translateY(24px)\', opacity: 0 },\n                { transform: \'translateY(0px)\', opacity: 1 },\n              ],\n              {\n                duration: 920,\n                delay: 180,\n                easing: \'cubic-bezier(0.16, 1, 0.3, 1)\',\n                fill: \'both\',\n              }\n            );\n          }\n\n          const brandPlate = document.getElementById(\'brand-plate\');\n          if (brandPlate) {\n            brandPlate.animate(\n              [\n                { transform: \'translateY(14px)\', opacity: 0 },\n                { transform: \'translateY(0px)\', opacity: 1 },\n              ],\n              {\n                duration: 760,\n                delay: 380,\n                easing: \'cubic-bezier(0.16, 1, 0.3, 1)\',\n                fill: \'both\',\n              }\n            );\n          }\n\n          const fadeBlocks = document.querySelectorAll(\'[data-anim-fade]\');\n          fadeBlocks.forEach((block, idx) => {\n            block.animate(\n              [\n                { transform: \'translateY(16px)\', opacity: 0 },\n                { transform: \'translateY(0px)\', opacity: 1 },\n              ],\n              {\n                duration: 720,\n                delay: 240 + idx * 90,\n                easing: \'cubic-bezier(0.16, 1, 0.3, 1)\',\n                fill: \'both\',\n              }\n            );\n          });\n        }\n\n        /* ----------------------------------------------------------------------\n           2. SLIDING ACTIVE PILL NAVIGATION\n           ---------------------------------------------------------------------- */\n        const navLinks = Array.from(document.querySelectorAll(\'.nav-link\'));\n        const navGlider = document.getElementById(\'nav-glider\');\n\n        function updateNavGlider(activeLink) {\n          if (!activeLink || !navGlider) return;\n          const offsetLeft = activeLink.offsetLeft;\n          const width = activeLink.offsetWidth;\n          navGlider.style.width = width + \'px\';\n          navGlider.style.transform = \'translateX(\' + (offsetLeft - 4) + \'px)\';\n        }\n\n        function setActiveNavByTarget(targetId) {\n          let matched = navLinks[0];\n          navLinks.forEach((link) => {\n            const isMatch = link.getAttribute(\'data-nav-target\') === targetId;\n            link.classList.toggle(\'is-active\', isMatch);\n            if (isMatch) {\n              link.setAttribute(\'aria-current\', \'true\');\n              matched = link;\n            } else {\n              link.removeAttribute(\'aria-current\');\n            }\n          });\n          updateNavGlider(matched);\n        }\n\n        navLinks.forEach((link) => {\n          link.addEventListener(\'click\', () => {\n            const target = link.getAttribute(\'data-nav-target\');\n            if (target) setActiveNavByTarget(target);\n          });\n        });\n\n        window.addEventListener(\'resize\', () => {\n          const currentActive = document.querySelector(\'.nav-link.is-active\') || navLinks[0];\n          updateNavGlider(currentActive);\n        });\n\n        /* ----------------------------------------------------------------------\n           3. MANIFESTO WORD-BY-WORD SCROLL REVEAL (#6F6F6F -> #F4F4F4, 3-word edge)\n           ---------------------------------------------------------------------- */\n        const manifestoSection = document.getElementById(\'manifesto\');\n        const manifestoStatement = document.getElementById(\'manifesto-statement\');\n        const manifestoWords = Array.from(document.querySelectorAll(\'.manifesto-word\'));\n        const totalWords = manifestoWords.length;\n        const EDGE_WIDTH = 3;\n\n        function clamp(val, min, max) {\n          return Math.max(min, Math.min(max, val));\n        }\n\n        function computeWordRevealFactor(wordIndex, count, progress) {\n          if (count <= 0) return 0;\n          const p = clamp(progress, 0, 1);\n          if (p <= 0) return 0;\n          if (p >= 1) return 1;\n          const virtualPos = p * (count + EDGE_WIDTH);\n          return clamp((virtualPos - wordIndex) / EDGE_WIDTH, 0, 1);\n        }\n\n        function interpolateWordColor(factor) {\n          const t = clamp(factor, 0, 1);\n          if (t <= 0.001) return \'#6F6F6F\';\n          if (t >= 0.999) return \'#F4F4F4\';\n          const r = Math.round(111 + (244 - 111) * t);\n          const g = Math.round(111 + (244 - 111) * t);\n          const b = Math.round(111 + (244 - 111) * t);\n          return \'rgb(\' + r + \', \' + g + \', \' + b + \')\';\n        }\n\n        function renderManifestoProgress(progress) {\n          manifestoWords.forEach((wordEl, idx) => {\n            const factor = computeWordRevealFactor(idx, totalWords, progress);\n            wordEl.style.color = interpolateWordColor(factor);\n          });\n        }\n\n        /* ----------------------------------------------------------------------\n           4. SCROLL OBSERVER & HERO PARALLAX\n           ---------------------------------------------------------------------- */\n        const heroPortrait = document.getElementById(\'hero-portrait-img\');\n        const studioSection = document.getElementById(\'studio\');\n        const workSection = document.getElementById(\'work\');\n\n        let ticking = false;\n\n        function onScrollFrame() {\n          ticking = false;\n          const scrollY = window.scrollY || window.pageYOffset;\n          const viewportH = window.innerHeight || 900;\n\n          // Subtle parallax on hero portrait\n          if (heroPortrait && !prefersReducedMotion && scrollY < viewportH * 1.2) {\n            const offset = Math.min(scrollY * 0.06, 36);\n            heroPortrait.style.transform = \'translateY(\' + offset.toFixed(1) + \'px)\';\n          }\n\n          // Manifesto reading-order scroll calculation\n          if (manifestoStatement && !isRecordingMode) {\n            const rect = manifestoStatement.getBoundingClientRect();\n            const startTrigger = viewportH * 0.82;\n            const endTrigger = viewportH * 0.24;\n            const rawProgress = (startTrigger - rect.top) / (startTrigger - endTrigger);\n            renderManifestoProgress(clamp(rawProgress, 0, 1));\n          }\n\n          // Update active navigation pill based on scroll position\n          if (workSection && studioSection) {\n            const workTop = workSection.getBoundingClientRect().top;\n            const studioTop = studioSection.getBoundingClientRect().top;\n            if (workTop <= viewportH * 0.45) {\n              setActiveNavByTarget(\'work\');\n            } else if (studioTop <= viewportH * 0.5) {\n              setActiveNavByTarget(\'studio\');\n            } else {\n              setActiveNavByTarget(\'home\');\n            }\n          }\n        }\n\n        window.addEventListener(\n          \'scroll\',\n          () => {\n            if (!ticking) {\n              window.requestAnimationFrame(onScrollFrame);\n              ticking = true;\n            }\n          },\n          { passive: true }\n        );\n\n        // Optional ?rec=1 time-based animation mode for automated visual capture\n        if (isRecordingMode) {\n          let startTs = null;\n          function stepRecManifesto(ts) {\n            if (!startTs) startTs = ts;\n            const elapsed = (ts - startTs) / 2600;\n            const cycleProgress = clamp(elapsed, 0, 1);\n            renderManifestoProgress(cycleProgress);\n            if (cycleProgress < 1) {\n              window.requestAnimationFrame(stepRecManifesto);\n            }\n          }\n          window.requestAnimationFrame(stepRecManifesto);\n        }\n\n        // Resilient image fallback handler\n        if (heroPortrait) {\n          heroPortrait.addEventListener(\'error\', () => {\n            heroPortrait.style.opacity = \'0\';\n          });\n        }\n\n        /* ----------------------------------------------------------------------\n           5. SELECTED INITIATIVES FILTERING & SPECIFICATION BRIEF MODAL\n           ---------------------------------------------------------------------- */\n        const INITIATIVE_BRIEFS = {\n          huni: {\n            title: \'HUNI\',\n            status: \'PRODUCT CONCEPT\',\n            category: \'Property Management / SaaS\',\n            classification: \'Proprietary SaaS Product Concept\',\n            description:\n              \'A digital property management platform designed to simplify boarding house operations, tenant management, billing, and reporting.\',\n            focus: [\n              \'Room inventory & occupancy status tracking across multi-unit boarding houses.\',\n              \'Automated recurring billing schedules and digital invoice ledger.\',\n              \'Structured tenant onboarding profiles and maintenance request workflows.\',\n              \'Clear financial and operational reporting for independent property owners.\',\n            ],\n          },\n          \'personal-os\': {\n            title: \'PERSONAL OS\',\n            status: \'PRODUCT CONCEPT\',\n            category: \'Productivity / Personal Software\',\n            classification: \'Independent Software Concept\',\n            description:\n              \'A personal productivity system designed to help individuals manage tasks, energy, goals, and daily progress.\',\n            focus: [\n              \'Unified daily execution view linking high-level goals with actionable tasks.\',\n              \'Intentional energy-state planning to align deep work with cognitive capacity.\',\n              \'Minimal, friction-free reflection and daily progress journaling.\',\n              \'Calm, distraction-free interface engineered for sustained personal clarity.\',\n            ],\n          },\n          \'sentul-trekking\': {\n            title: \'SENTUL TREKKING INFORMATION SYSTEM\',\n            status: \'COMMUNITY PROJECT\',\n            category: \'Community Digitalization / Web Development\',\n            classification: \'Community Digitalization Initiative\',\n            description:\n              \'A community-oriented information platform providing trekking destination information and booking contact access.\',\n            focus: [\n              \'Structured trail directory covering route difficulty, elevation, and duration.\',\n              \'Direct local guide and community booking contact access.\',\n              \'Preparation checklists and safety advisories for regional visitors.\',\n              \'Mobile-friendly web architecture built for fast access on low-bandwidth connections.\',\n            ],\n          },\n        };\n\n        const filterButtons = Array.from(document.querySelectorAll(\'[data-filter]\'));\n        const initiativeCards = Array.from(document.querySelectorAll(\'.initiative-card\'));\n\n        filterButtons.forEach((btn) => {\n          btn.addEventListener(\'click\', () => {\n            const selectedFilter = btn.getAttribute(\'data-filter\');\n            filterButtons.forEach((b) => {\n              const active = b === btn;\n              b.classList.toggle(\'is-active\', active);\n              b.setAttribute(\'aria-pressed\', active ? \'true\' : \'false\');\n            });\n\n            initiativeCards.forEach((card) => {\n              const cardCategory = card.getAttribute(\'data-category-type\');\n              if (selectedFilter === \'all\' || cardCategory === selectedFilter) {\n                card.removeAttribute(\'hidden\');\n              } else {\n                card.setAttribute(\'hidden\', \'\');\n              }\n            });\n          });\n        });\n\n        /* ----------------------------------------------------------------------\n           6. DIALOG CONTROLLERS & VALIDATED STUDIO INQUIRY FORM\n           ---------------------------------------------------------------------- */\n        const contactBackdrop = document.getElementById(\'contact-modal-backdrop\');\n        const closeContactBtn = document.getElementById(\'close-contact-modal\');\n        const inquiryForm = document.getElementById(\'studio-inquiry-form\');\n        const inquiryDirectionSelect = document.getElementById(\'inquiry-direction\');\n        const inquiryConfirmation = document.getElementById(\'inquiry-confirmation\');\n        const inquiryConfirmationText = document.getElementById(\'inquiry-confirmation-text\');\n        const resetInquiryBtn = document.getElementById(\'reset-inquiry-btn\');\n\n        const projectBackdrop = document.getElementById(\'project-modal-backdrop\');\n        const closeProjectBtn = document.getElementById(\'close-project-modal\');\n        const projectInquireBtn = document.getElementById(\'project-dialog-inquire-btn\');\n        let activeProjectTitle = \'\';\n\n        function openContactModal(preselectedTopic) {\n          if (!contactBackdrop) return;\n          if (preselectedTopic && inquiryDirectionSelect) {\n            const options = Array.from(inquiryDirectionSelect.options);\n            const matchedOption = options.find((opt) =>\n              opt.value.toLowerCase().includes(preselectedTopic.toLowerCase())\n            );\n            if (matchedOption) {\n              inquiryDirectionSelect.value = matchedOption.value;\n            } else {\n              inquiryDirectionSelect.value = \'General Studio Conversation\';\n            }\n          }\n          contactBackdrop.classList.add(\'is-open\');\n          contactBackdrop.setAttribute(\'aria-hidden\', \'false\');\n          const nameInput = document.getElementById(\'inquiry-name\');\n          if (nameInput) nameInput.focus();\n        }\n\n        function closeContactModal() {\n          if (!contactBackdrop) return;\n          contactBackdrop.classList.remove(\'is-open\');\n          contactBackdrop.setAttribute(\'aria-hidden\', \'true\');\n        }\n\n        function openProjectModal(projectId) {\n          const data = INITIATIVE_BRIEFS[projectId];\n          if (!data || !projectBackdrop) return;\n          activeProjectTitle = data.title;\n          document.getElementById(\'project-dialog-status\').textContent = data.status;\n          document.getElementById(\'project-dialog-title\').textContent = data.title;\n          document.getElementById(\'project-dialog-category\').textContent = data.category;\n          document.getElementById(\'project-dialog-classification\').textContent =\n            data.classification;\n          document.getElementById(\'project-dialog-description\').textContent = data.description;\n\n          const focusList = document.getElementById(\'project-dialog-focus\');\n          focusList.innerHTML = \'\';\n          data.focus.forEach((item) => {\n            const li = document.createElement(\'li\');\n            li.textContent = item;\n            focusList.appendChild(li);\n          });\n\n          projectBackdrop.classList.add(\'is-open\');\n          projectBackdrop.setAttribute(\'aria-hidden\', \'false\');\n          closeProjectBtn.focus();\n        }\n\n        function closeProjectModal() {\n          if (!projectBackdrop) return;\n          projectBackdrop.classList.remove(\'is-open\');\n          projectBackdrop.setAttribute(\'aria-hidden\', \'true\');\n        }\n\n        document.querySelectorAll(\'[data-open-contact]\').forEach((trigger) => {\n          trigger.addEventListener(\'click\', () => {\n            const topic = trigger.getAttribute(\'data-open-contact\');\n            openContactModal(topic);\n          });\n        });\n\n        document.querySelectorAll(\'[data-inspect-project]\').forEach((trigger) => {\n          trigger.addEventListener(\'click\', () => {\n            const pid = trigger.getAttribute(\'data-inspect-project\');\n            openProjectModal(pid);\n          });\n        });\n\n        if (closeContactBtn) closeContactBtn.addEventListener(\'click\', closeContactModal);\n        if (closeProjectBtn) closeProjectBtn.addEventListener(\'click\', closeProjectModal);\n\n        if (projectInquireBtn) {\n          projectInquireBtn.addEventListener(\'click\', () => {\n            closeProjectModal();\n            openContactModal(\'Initiative Inquiry\');\n            const msgArea = document.getElementById(\'inquiry-message\');\n            if (msgArea && activeProjectTitle && !msgArea.value) {\n              msgArea.value =\n                \'I would like to discuss the \' + activeProjectTitle + \' initiative with Rekavanta.\';\n            }\n          });\n        }\n\n        window.addEventListener(\'keydown\', (e) => {\n          if (e.key === \'Escape\') {\n            closeContactModal();\n            closeProjectModal();\n          }\n        });\n\n        [contactBackdrop, projectBackdrop].forEach((backdrop) => {\n          if (!backdrop) return;\n          backdrop.addEventListener(\'click\', (e) => {\n            if (e.target === backdrop) {\n              closeContactModal();\n              closeProjectModal();\n            }\n          });\n        });\n\n        // Form validation & submission\n        function clearErrors() {\n          [\'name\', \'email\', \'direction\', \'message\'].forEach((field) => {\n            const errEl = document.getElementById(\'error-\' + field);\n            if (errEl) errEl.textContent = \'\';\n          });\n        }\n\n        if (inquiryForm) {\n          inquiryForm.addEventListener(\'submit\', (e) => {\n            e.preventDefault();\n            clearErrors();\n\n            const nameVal = (document.getElementById(\'inquiry-name\').value || \'\').trim();\n            const emailVal = (document.getElementById(\'inquiry-email\').value || \'\').trim();\n            const directionVal = (document.getElementById(\'inquiry-direction\').value || \'\').trim();\n            const messageVal = (document.getElementById(\'inquiry-message\').value || \'\').trim();\n\n            let hasError = false;\n\n            if (nameVal.length < 2) {\n              document.getElementById(\'error-name\').textContent =\n                \'Please enter your name (at least 2 characters).\';\n              hasError = true;\n            }\n\n            const emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\n            if (!emailPattern.test(emailVal)) {\n              document.getElementById(\'error-email\').textContent =\n                \'Please provide a valid email address.\';\n              hasError = true;\n            }\n\n            if (!directionVal) {\n              document.getElementById(\'error-direction\').textContent =\n                \'Please select a business direction or topic.\';\n              hasError = true;\n            }\n\n            if (messageVal.length < 12) {\n              document.getElementById(\'error-message\').textContent =\n                \'Please share a brief overview (at least 12 characters).\';\n              hasError = true;\n            }\n\n            if (hasError) return;\n\n            inquiryForm.setAttribute(\'hidden\', \'\');\n            inquiryConfirmation.removeAttribute(\'hidden\');\n            inquiryConfirmationText.textContent =\n              \'Thank you, \' +\n              nameVal +\n              \'. Your note regarding \"\' +\n              directionVal +\n              \'\" has been recorded. We will respond via \' +\n              emailVal +\n              \'.\';\n          });\n        }\n\n        if (resetInquiryBtn) {\n          resetInquiryBtn.addEventListener(\'click\', () => {\n            inquiryForm.reset();\n            clearErrors();\n            inquiryConfirmation.setAttribute(\'hidden\', \'\');\n            inquiryForm.removeAttribute(\'hidden\');\n          });\n        }\n\n        // Initialize on load\n        window.addEventListener(\'DOMContentLoaded\', () => {\n          updateNavGlider(document.querySelector(\'.nav-link.is-active\') || navLinks[0]);\n          runEntranceAnimations();\n          onScrollFrame();\n        });\n      })();\n    </script>\n  </body>\n</html>\n"
        path {
          absolute_uri: "file:///index.html"
        }
        overwrite: true
      }
    }
    action_result {
      edit {
        diff {
          end_line: 18
          unified_diff {
            lines {
              text: "<!doctype html>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "<html lang=\"en\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
