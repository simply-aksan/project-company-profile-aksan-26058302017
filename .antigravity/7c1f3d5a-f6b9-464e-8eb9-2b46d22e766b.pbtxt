            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        function clamp(v, min, max) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          return Math.max(min, Math.min(max, v));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
