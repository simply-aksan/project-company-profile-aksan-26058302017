-title {\\n          font-size: calc(54 * var(--u));\\n        }\\n\\n        .hero-title-sup {\\n          left: calc(174 * var(--u));\\n          top: calc(4 * var(--u));\\n        }\\n\\n        .hero-about-box,\\n        .hero-cta-row {\\n          position: relative;\\n          left: auto;\\n          top: auto;\\n          width: 100%;\\n        }\\n\\n        /* Full-width photo (470u) with brand plate and wordmarks over it */\\n        .hero-photo-wrap {\\n          position: relative;\\n          left: auto;\\n          top: auto;\\n          width: 100%;\\n          height: calc(470 * var(--u));\\n          border-radius: calc(12 * var(--u));\\n          overflow: hidden;\\n          -webkit-mask-image: none;\\n          mask-image: none;\\n        }\\n\\n        .hero-brand-plate {\\n          left: calc(16 * var(--u));\\n          right: calc(16 * var(--u));\\n          top: auto;\\n          bottom: calc(56 * var(--u));\\n          width: auto;\\n        }\\n\\n        .hero-jacket-wordmarks {\\n          left: calc(16 * var(--u));\\n          right: calc(16 * var(--u));\\n          top: auto;\\n          bottom: calc(18 * var(--u));\\n          width: auto;\\n          font-size: calc(11 * var(--u));\\n          gap: calc(12 * var(--u));\\n        }\"}, {\"AllowMultiple\":false, \"EndLine\":1291, \"ReplacementContent\":\"        <!-- Central Monochromatic Hero Photo + Brand Plate + Conceptual Labels -->\\n        <div class=\\\"hero-mobile-visual-stage\\\">\\n          <div class=\\\"hero-photo-wrap\\\" id=\\\"hero-photo-wrap\\\">\\n            <img\\n              src=\\\"https://d2ol7oe51mr4n9.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/7dc8b8f3-4ccb-4599-8ce4-7f7c7881bad9.webp\\\"\\n              data-fallback-src=\\\"/src/assets/images/rekavanta_hero_founder_1794122363916.jpg\\\"\\n              alt=\\\"Monochromatic editorial portrait of an East Asian technology founder seen from behind in a technical jacket\\\"\\n              class=\\\"hero