        target_content: "      :focus-visible {\n        outline: 2px solid var(--accent);\n        outline-offset: 3px;\n      }"
        replacement_content: "      :focus-visible {\n        outline: 2px solid var(--accent);\n        outline-offset: 3px;\n      }\n\n      /* Fixed Top White Scroll Progress Bar (Compositor-Only scaleX) */\n      .page-scroll-progress-track {\n        position: fixed;\n        top: 0;\n        left: 0;\n        right: 0;\n        height: 3px;\n        background-color: rgba(17, 17, 17, 0.14);\n        z-index: 95;\n        pointer-events: none;\n        overflow: hidden;\n      }\n\n      .page-scroll-progress-bar {\n        width: 100%;\n        height: 100%;\n        background-color: #ffffff;\n        box-shadow: 0 0 6px rgba(0, 0, 0, 0.28);\n        transform-origin: left center;\n        transform: scaleX(0);\n        will-change: transform;\n      }"
        start_line: 95
        end_line: 101
      }
      use_global_match: true
    }
    replacement_infos {
      original_chunk {
        target_content: "  <body>\n    <!-- ========================================================================\n         SECTION 01 \342\200\224 HERO / COMPANY INTRODUCTION (1440 x 938u ARTBOARD)\n         ======================================================================== -->"
        replacement_content: "  <body>\n    <!-- Fixed Top White Scroll Progress Indicator -->\n    <div\n      class=\"page-scroll-progress-track\"\n      role=\"progressbar\"\n      aria-label=\"Page scroll progress\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n      aria-valuenow=\"0\"\n      id=\"page-scroll-progress-track\"\n    >\n      <div class=\"page-scroll-progress-bar\" id=\"page-scroll-progress-bar\"></div>\n    </div>\n\n    <!-- ========================================================================\n         SECTION 01 \342\200\224 HERO / COMPANY INTRODUCTION (1440 x 938u ARTBOARD)\n         ======================================================================== -->"
        start_line: 1151
        end_line: 1158
      }
      use_global_match: true
    }
    replacement_infos {
      original_chunk {
        target_content: "        /* ----------------------------------------------------------------------\n           7. SCROLL DRIFT (0.12x) & RECORDER MODE (?rec=1)\n           ---------------------------------------------------------------------- */\n        let scrollTicking = false;\n\n        function onScrollUpdate() {\n          scrollTicking = false;\n          if (isRecMode) return;\n\n          const scrollY = window.scrollY || window.pageYOffset;\n          const vh = window.innerHeight || 900;"
        replacement_content: "        /* ----------------------------------------------------------------------\n           7. SCROLL DRIFT (0.12x), TOP PROGRESS BAR & RECORDER MODE (?rec=1)\n           ---------------------------------------------------------------------- */\n        const pageProgressBar = document.getElementById(\'page-scroll-progress-bar\');\n        const pageProgressTrack = document.getElementById(\'page-scroll-progress-track\');\n        let scrollTicking = false;\n\n        function updatePageScrollProgress(scrollY, vh) {\n          if (!pageProgressBar) return;\n          const docHeight = Math.max(\n            document.body.scrollHeight,\n            document.documentElement.scrollHeight\n          );\n          const maxScroll = docHeight - vh;\n          const ratio = maxScroll > 0 ? clamp(scrollY / maxScroll, 0, 1) : 0;\n          pageProgressBar.style.transform = \'scaleX(\' + ratio.toFixed(4) + \')\';\n          if (pageProgressTrack) {\n            pageProgressTrack.setAttribute(\'aria-valuenow\', String(Math.round(ratio * 100)));\n          }\n        }\n\n        function onScrollUpdate() {\n          scrollTicking = false;\n          const scrollY = window.scrollY || window.pageYOffset;\n          const vh = window.innerHeight || 900;\n\n          updatePageScrollProgress(scrollY, vh);\n\n          if (isRecMode) return;"
        start_line: 1882
        end_line: 1895
      }
      use_global_match: true
    }
    replacement_infos {
      original_chunk {
        target_content: "        window.addEventListener(\n          \'scroll\',\n          () => {\n            if (!scrollTicking) {\n              requestAnimationFrame(onScrollUpdate);\n              scrollTicking = true;\n            }\n          },\n          { passive: true }\n        );"
        replacement_content: "        window.addEventListener(\n          \'scroll\',\n          () => {\n            if (!scrollTicking) {\n              requestAnimationFrame(onScrollUpdate);\n              scrollTicking = true;\n            }\n          },\n          { passive: true }\n        );\n\n        window.addEventListener(\n          \'resize\',\n          () => {\n            if (!scrollTicking) {\n              requestAnimationFrame(onScrollUpdate);\n              scrollTicking = true;\n            }\n          },\n          { passive: true }\n        );"
        start_line: 1925
        end_line: 1945
      }
      use_global_match: true
