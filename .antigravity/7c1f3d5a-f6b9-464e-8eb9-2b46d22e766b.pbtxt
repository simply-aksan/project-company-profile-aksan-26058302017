Jacket at y 864 -->\n          <div class=\"hero-jacket-wordmarks\" data-hero-stagger>\n            <span>SOFTWARE</span>\n            <span class=\"wordmark-dot\" aria-hidden=\"true\">\302\267</span>\n            <span>PRODUCTS</span>\n            <span class=\"wordmark-dot\" aria-hidden=\"true\">\302\267</span>\n            <span>INTELLIGENCE</span>\n          </div>\n        </div>"
