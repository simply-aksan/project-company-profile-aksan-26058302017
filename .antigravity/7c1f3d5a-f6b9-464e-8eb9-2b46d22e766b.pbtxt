        target_content: "        .hero-title {\n          font-size: calc(54 * var(--u));\n        }\n\n        .hero-title-sup {\n          left: calc(174 * var(--u));\n          top: calc(4 * var(--u));\n        }\n\n        .hero-about-box,\n        .hero-cta-row {\n          position: relative;\n          left: auto;\n          top: auto;\n          width: 100%;\n        }\n\n        /* Full-width photo (470u) with brand plate and wordmarks over it */\n        .hero-photo-wrap {\n          position: relative;\n          left: auto;\n          top: auto;\n          width: 100%;\n          height: calc(470 * var(--u));\n          border-radius: calc(12 * var(--u));\n          overflow: hidden;\n          -webkit-mask-image: none;\n          mask-image: none;\n        }\n\n        .hero-brand-plate {\n          left: calc(16 * var(--u));\n          right: calc(16 * var(--u));\n          top: auto;\n          bottom: calc(56 * var(--u));\n          width: auto;\n        }\n\n        .hero-jacket-wordmarks {\n          left: calc(16 * var(--u));\n          right: calc(16 * var(--u));\n          top: auto;\n          bottom: calc(18 * var(--u));\n          width: auto;\n          font-size: calc(11 * var(--u));\n          gap: calc(12 * var(--u));\n        }"
