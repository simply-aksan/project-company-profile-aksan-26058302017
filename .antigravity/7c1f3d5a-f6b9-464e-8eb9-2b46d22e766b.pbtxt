            }
            lines {
              text: "           ---------------------------------------------------------------------- */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const heroPhoto = document.getElementById(\'hero-photo\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (heroPhoto) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          heroPhoto.addEventListener(\'error\', function onHeroImgError() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const fallback = heroPhoto.getAttribute(\'data-fallback-src\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (fallback && heroPhoto.src !== fallback) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              heroPhoto.src = fallback;"
